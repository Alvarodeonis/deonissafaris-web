---
import ContinentIcon from '../components/ContinentIcon.astro';
import Search from '../components/Search.astro';
import { groups, subgroups, speciesIn, speciesUrl, groupUrl } from '../data/species.js';
import '../styles/global.css';
import { categories, contact } from '../data/site.js';
import { u } from '../lib/url.js';
import { LANGS, ACTIVE, lang, langInfo, stripLang, pathIn, t } from '../i18n/index.js';
import { countries as countriesOf } from '../data/programs.js';
const arcoCountries = countriesOf('caza-con-arco');
const sg = (slug) => groups.find((g) => g.slug === slug);
const mayorSubs = subgroups['caza-mayor'].filter((x) => speciesIn('caza-mayor', x).length);
const lupa = '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21" /></svg>';

const { title, description: rawDesc = 'Safaris de caza internacional a medida en cinco continentes. Más de 30 años organizando cacerías donde nuestro equipo ya ha cazado.', image, transparentHeader = false, crumbs = [], schema = [], canonicalPath } = Astro.props;
// SEO: descripción entre ~70 y 160 caracteres, cortada por palabra.
const clean = (t) => String(t).replace(/\s+/g, ' ').trim();
let description = clean(rawDesc);
if (description.length < 90) description = `${description.replace(/\.?$/, '.')} Safaris de caza a medida con de Onís Safaris, más de 30 años de experiencia.`;
if (description.length > 160) description = description.slice(0, 157).replace(/[\s,;:·.(]+[^\s]*$/, '') + '…';
const site = Astro.site ?? new URL('https://www.deonissafaris.com');
const canonical = new URL((canonicalPath ? u(canonicalPath) : Astro.url.pathname).replace(/\/?$/, '/'), site).href;
// La vista previa en github.io no debe indexarse: duplicaría la web real.
const preview = /github\.io/.test(site.host);
const L = lang();
const relPath = stripLang(Astro.url.pathname);
const altPath = canonicalPath ?? relPath;
const alternates = LANGS.filter((x) => ACTIVE.includes(x.code)).map((x) => ({ ...x, href: new URL(pathIn(x.code, altPath), site).href }));
const home = new URL(u().replace(/\/?$/, '/'), site).href;
const abs = (x) => (x ? new URL(x, site).href : undefined);
const org = {
  '@type': 'TravelAgency', '@id': home + '#org', name: 'de Onís Safaris', legalName: 'Onrom S.L.',
  url: home, logo: abs(u('logo.png')), image: abs(u('img/namibia-kudu.jpg')),
  telephone: contact.phone, email: contact.email,
  address: { '@type': 'PostalAddress', streetAddress: 'Calle Doctor Velázquez 10', addressLocality: 'Pozuelo de Alarcón', addressRegion: 'Madrid', addressCountry: 'ES' },
  sameAs: Object.values(contact.social),
};
const ld = [org, { '@type': 'WebSite', '@id': home + '#web', name: 'de Onís Safaris', url: home, inLanguage: langInfo(L).hreflang, publisher: { '@id': org['@id'] } }];
if (crumbs.length) ld.push({ '@type': 'BreadcrumbList', itemListElement: [['Inicio', ''], ...crumbs].map(([name, path], i) => ({ '@type': 'ListItem', position: i + 1, name, item: new URL(u(path).replace(/\/?$/, '/'), site).href })) });
ld.push(...schema);
const jsonld = JSON.stringify({ '@context': 'https://schema.org', '@graph': ld }).replace(/</g, '\\u003c');
const links = [
  ['Safari Club International', 'https://safariclub.org/'],
  ['Federación Española de Caza', 'https://www.fecaza.com/'],
  ['Ministerio de Asuntos Exteriores', 'https://www.exteriores.gob.es/'],
  ['Convertidor de divisas', 'https://www.xe.com/es/'],
];
const fullTitle = !title ? 'de Onís Safaris · Safaris de caza internacional' : `${title} · de Onís Safaris`.length <= 62 ? `${title} · de Onís Safaris` : title;
const wa = `https://wa.me/${contact.whatsapp}?text=${encodeURIComponent('Hola, me gustaría información sobre un safari de caza.')}`;
---
<!doctype html>
<html lang={langInfo(L).hreflang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {preview && <meta name="robots" content="noindex, follow" />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="de Onís Safaris" />
  <meta property="og:locale" content={langInfo(L).og} />
  {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
  <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={abs(image) ?? abs(u('img/namibia-kudu.jpg'))} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={jsonld} />
  <script id="i18n-data" type="application/json">{}</script>
  <script is:inline>window.tt=function(s,v){var d=window.__i18n||(window.__i18n=JSON.parse(document.getElementById('i18n-data').textContent||'{}'));var r=d[s]||s;if(v&&typeof v.n==='number')r=window.tpl(r,v.n);return v?r.replace(/\{(\w+)\}/g,function(m,k){return k in v?v[k]:m}):r};window.tpl=function(r,n){if(r.indexOf('|')<0||!/^[a-z]+:/.test(r))return r;var m={};r.split('|').forEach(function(p){var i=p.indexOf(':');m[p.slice(0,i)]=p.slice(i+1)});var c='other';try{c=new Intl.PluralRules(document.documentElement.lang).select(n)}catch(e){}return m[c]||m.other||m.many||r};window.tn=function(n,one,other){return window.tpl(window.tt(n===1?one:other),n)};window.money=function(n,c){var l=(document.documentElement.lang||'es').slice(0,2),v=String(Math.round(n)),S={en:[',',1],zh:[',',1],fr:['\u202f'],cs:['\u00a0'],pl:['\u00a0',0,5,'USD'],pt:['\u00a0',0,5,'USD'],hu:['\u00a0',0,5],ru:['\u00a0',0,5]}[l]||['.'];if(v.length>=(S[2]||4))v=v.replace(/\B(?=(\d{3})+(?!\d))/g,S[0]);var u=c==='USD';if(S[1]===1)return(u?'US$':'€')+v;if(l==='es')return u?'US$ '+v:v+' €';return v+'\u00a0'+(u?(S[3]||'US$'):'€')};</script>
  <link rel="icon" href={u('favicon.ico')} sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href={u('favicon-32.png')} />
  <link rel="icon" type="image/png" sizes="192x192" href={u('favicon-192.png')} />
  <link rel="apple-touch-icon" href={u('favicon-180.png')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Jost:wght@300;400;500&family=Montserrat:wght@400&family=Roboto+Slab:wght@400&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Jost:wght@300;400;500&family=Montserrat:wght@400&family=Roboto+Slab:wght@400&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Jost:wght@300;400;500&family=Montserrat:wght@400&family=Roboto+Slab:wght@400&display=swap" /></noscript>
</head>
<body>
  <header class:list={['site-header', { always: !transparentHeader }]} id="header">
    <div class="wrap">
      <a class="logo" href={u()} aria-label="de Onís Safaris, inicio"><img src={u('logo.png')} alt="de Onís Safaris · Born wild, free forever" width="150" height="166" /></a>
      <button class="sx-open sx-mob" type="button" data-sx-open aria-label="Buscar" set:html={lupa} />
      <button class="menu-toggle" type="button" id="menu-open" aria-controls="nav" aria-expanded="false">Menú</button>
      <nav class="main-nav" id="nav" aria-label="Principal">
        <button class="menu-toggle menu-close" type="button" id="menu-close">Cerrar</button>
        <div class="dropdown">
          <button type="button" aria-haspopup="true">Caza con rifle</button>
          <div class="dropdown-menu">
            {categories.filter((c) => c.slug !== 'caza-con-arco').map((c) => (
              <a href={u(c.slug)}><ContinentIcon slug={c.slug} class="cemo" /><span class="ctx">{c.title}<small>{c.tagline}</small></span></a>
            ))}
          </div>
        </div>
        <a href={u('caza-con-arco')}>Caza con arco</a>
        <div class="dropdown sp-dd">
          <button type="button" aria-haspopup="true">Por especie</button>
          <div class="dropdown-menu mega">
            <div class="mcol">
              <a class="mh" href={u(groupUrl('big-five'))}>Big Five</a>
              {speciesIn('big-five').map((s) => <a href={u(speciesUrl(s))}>{s.name}</a>)}
              <a class="mh" href={u(groupUrl('caza-menor'))}>Caza menor</a>
              {speciesIn('caza-menor').map((s) => <a href={u(speciesUrl(s))}>{s.name}</a>)}
            </div>
            {mayorSubs.map((x) => (
              <div class="mcol">
                <a class="mh" href={u(groupUrl('caza-mayor'))}>Caza mayor<small>{x}</small></a>
                {speciesIn('caza-mayor', x).map((s) => <a href={u(speciesUrl(s))}>{s.name}</a>)}
              </div>
            ))}
            <a class="mall" href={u('especies')}>Ver todas las especies →</a>
          </div>
          <div class="dropdown-menu mob">
            {groups.filter((g) => speciesIn(g.slug).length).map((g) => <a href={u(groupUrl(g))}>{g.name}</a>)}
            <a href={u('especies')}>Todas las especies</a>
          </div>
        </div>
        <a href={u('fotos')}>Fotos</a>
        <a href={u('videos')}>Películas</a>
        <a href={u('articulos-revistas')}>Artículos / revistas</a>
        <a href={u('sobre-nosotros')}>Sobre nosotros</a>
        <a class="nav-cta" href={u('contacto')}>Contacto</a>
        <button class="sx-open sx-desk" type="button" data-sx-open aria-label="Buscar (tecla /)" set:html={lupa} />
        {alternates.length > 1 && (
          <div class="dropdown lang-dd">
            <button type="button" aria-haspopup="true" aria-label="Idioma / Language">{langInfo(L).short}</button>
            <div class="dropdown-menu">
              {alternates.map((a) => <a href={pathIn(a.code, relPath)} hreflang={a.hreflang} lang={a.hreflang} data-code={a.code} class:list={[{ on: a.code === L }]}>{a.name}</a>)}
            </div>
          </div>
        )}
        {alternates.length > 1 && (
          <label class="lang-sel">
            <span class="sr">Idioma / Language</span>
            <select aria-label="Idioma / Language" onchange="try{localStorage.setItem('lang-choice',this.selectedOptions[0].dataset.code)}catch(e){};location.href=this.value">
              {alternates.map((a) => <option value={pathIn(a.code, relPath)} data-code={a.code} selected={a.code === L}>{a.name}</option>)}
            </select>
          </label>
        )}
      </nav>
    </div>
  </header>

  <main><slot /></main>

  <footer class="site-footer">
    <div class="f-hero">
      <img class="f-bg" src={u('img/namibia-kudu.jpg')} alt="" aria-hidden="true" loading="lazy" />
      <div class="wrap f-hero-in">
        <div class="f-top">
        <a class="f-logo" href={u()} aria-label="de Onís Safaris, inicio"><img src={u('logo.png')} alt="de Onís Safaris" width="120" height="133" /></a>
        <div class="f-brand">
          <p class="motto">Born wild · Free forever</p>
          <p class="claim">Safaris de caza internacional a medida desde hace más de treinta años. Solo le llevamos donde nuestro equipo ya ha cazado.</p>
        </div>
        <div class="f-cta">
          <a class="btn" href={u('contacto')}>Planifica tu cacería</a>
          <a class="f-tel" href={`tel:${contact.mobile.replace(/\s/g, '')}`}>{contact.mobile}</a>
        </div>
      
        </div>
        <div class="f-follow">
        <p class="follow-k">Síguenos en redes</p>
        <a class="fcard ig" href={contact.social.instagram} target="_blank" rel="noopener">
          <span class="fi"><svg viewBox="0 0 24 24"><path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zM17.3 5.5a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4zM12 2.2c2.7 0 3 0 4 .1 2.8.1 4.1 1.4 4.2 4.2.1 1 .1 1.3.1 4s0 3-.1 4c-.1 2.7-1.4 4.1-4.2 4.2-1 .1-1.3.1-4 .1s-3 0-4-.1c-2.8-.1-4.1-1.5-4.2-4.2-.1-1-.1-1.3-.1-4s0-3 .1-4C3.9 3.7 5.2 2.4 8 2.3c1-.1 1.3-.1 4-.1z"/></svg></span>
          <span class="ft"><b>Instagram</b><small>@deonissafaris · las cacerías de cada temporada, contadas en fotos</small></span>
          <span class="fgo">Seguir</span>
        </a>
        <a class="fcard yt" href={contact.social.youtube} target="_blank" rel="noopener">
          <span class="fi"><svg viewBox="0 0 24 24"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.8a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8zM9.7 15V9l5.8 3z"/></svg></span>
          <span class="ft"><b>YouTube</b><small>De Onís Safaris · nuestras películas de caza completas</small></span>
          <span class="fgo">Suscribirse</span>
        </a>
      </div>
      </div>
    </div>
    <div class="wrap">
      <div class="cols">
        <div>
          <h4>Caza con rifle</h4>
          <ul>{categories.filter((c) => c.slug !== 'caza-con-arco').map((c) => <li><a href={u(c.slug)}>{c.title.replace('Caza en ', '')}</a></li>)}</ul>
        </div>
        <div>
          <h4>Caza con arco</h4>
          <ul>{arcoCountries.map((c) => <li><a href={u(`caza-con-arco/${c.slug}`)}>{c.name}</a></li>)}</ul>
        </div>
        <div>
          <h4>Pesca y fotografía</h4>
          <ul>
            <li><a href={u('pesca')}>Viajes de pesca</a></li>
            <li><a href={u('safaris-fotograficos')}>Safaris fotográficos</a></li>
          </ul>
        </div>
        <div>
          <h4>Contacto</h4>
          <ul class="contacts">
            <li><span class="f-who">Madrid · Oficina central</span><b>Arturo</b><a class="f-phone" href={`tel:${contact.mobile.replace(/\s/g, '')}`}>{contact.mobile}</a></li>
            <li><span class="f-who">Caza con arco</span><b>Álvaro</b><a class="f-phone" href={`tel:${contact.bowPhone.replace(/\s/g, '')}`}>{contact.bowPhone}</a></li>
            {contact.offices.slice(1).map((o) => <li><b>{o.city}</b><a class="f-phone sm" href={`tel:${o.phone.replace(/\s/g, '')}`}>{o.phone}</a></li>)}
          </ul>
          <p class="f-mail"><a href={`mailto:${contact.email}`}>{contact.email}</a><br />{contact.address}</p>
          <div class="social"><a href={contact.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24"><path d="M13.5 21v-8h2.7l.4-3.2h-3.1V7.8c0-.9.3-1.5 1.6-1.5h1.7V3.5a22 22 0 0 0-2.5-.1c-2.4 0-4.1 1.5-4.1 4.2v2.3H7.5V13h2.7v8z"/></svg></a></div>
        </div>
      </div>
      <div class="links">
        <span>Enlaces de interés</span>
        {links.map(([n, h]) => <a href={h} target="_blank" rel="noopener">{n}</a>)}
      </div>
      {alternates.length > 1 && (
        <nav class="f-langs" aria-label="Idioma / Language">
          {alternates.map((a) => <a href={pathIn(a.code, relPath)} hreflang={a.hreflang} lang={a.hreflang} data-code={a.code} class:list={[{ on: a.code === L }]}>{a.name}</a>)}
        </nav>
      )}
      <div class="legal">
        <span>© {new Date().getFullYear()} de Onís Safaris · Todos los derechos reservados</span>
        <span><a href={u('aviso-legal')}>Aviso legal</a><a href={u('politica-de-privacidad')}>Privacidad</a><a href={u('politica-de-cookies')}>Cookies</a></span>
      </div>
    </div>
  </footer>

  <Search />

  {alternates.length > 1 && (
    <div class="lang-hint" id="lang-hint" hidden data-cur={L} data-alts={JSON.stringify(alternates.filter((a) => a.code !== L).map((a) => ({ c: a.code, h: pathIn(a.code, relPath), s: a.suggest, g: a.go })))}>
      <span id="lang-hint-t"></span>
      <a id="lang-hint-go" href="#"></a>
      <button type="button" id="lang-hint-x" aria-label="×">×</button>
    </div>
  )}

  <a class="wa-float" href={wa} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
    <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm0 23.7c-2 0-4-.5-5.7-1.6l-.4-.2-3.9 1 1-3.8-.3-.4A10.7 10.7 0 1 1 16 26.7zm5.9-8c-.3-.2-1.9-1-2.2-1-.3-.1-.5-.2-.7.1l-1 1.3c-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.7l.5-.6.3-.5c.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.4c.2.2 2.4 3.6 5.8 5 .8.4 1.4.6 1.9.7.8.3 1.5.2 2.1.1.6-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5-.1-.2-.3-.3-.6-.4z"/></svg>
  </a>

  <script>
    const header = document.getElementById('header');
    const onScroll = () => header.classList.toggle('solid', window.scrollY > 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    const nav = document.getElementById('nav');
    const open = document.getElementById('menu-open');
    open.addEventListener('click', () => { nav.classList.add('open'); open.setAttribute('aria-expanded', 'true'); });
    // Aviso de idioma: si el navegador está en otro idioma disponible, se sugiere (sin redirigir).
    const hint = document.getElementById('lang-hint');
    if (hint) {
      const store = (k, v) => { try { return v === undefined ? localStorage.getItem(k) : localStorage.setItem(k, v); } catch { return null; } };
      const cur = hint.dataset.cur!;
      const alts = JSON.parse(hint.dataset.alts || '[]');
      const pref = (navigator.languages || [navigator.language]).map((l) => l.slice(0, 2).toLowerCase());
      const first = pref[0];
      const alt = first && first !== cur ? alts.find((a: any) => a.c === first) : null;
      if (alt && store('lang-choice') !== cur && !store('lang-hint-off')) {
        document.getElementById('lang-hint-t')!.textContent = alt.s;
        const go = document.getElementById('lang-hint-go') as HTMLAnchorElement;
        go.textContent = alt.g; go.href = alt.h;
        go.addEventListener('click', () => store('lang-choice', alt.c));
        document.getElementById('lang-hint-x')!.addEventListener('click', () => { store('lang-hint-off', '1'); store('lang-choice', cur); hint.hidden = true; });
        hint.hidden = false;
      }
      document.querySelectorAll<HTMLAnchorElement>('.lang-dd a[hreflang], .f-langs a').forEach((a) => a.addEventListener('click', () => store('lang-choice', a.dataset.code || '')));
    }
    document.getElementById('menu-close').addEventListener('click', () => { nav.classList.remove('open'); open.setAttribute('aria-expanded', 'false'); });
  </script>
</body>
</html>
