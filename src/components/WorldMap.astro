---
// Mapa del mundo estático (SVG generado en el build) con los países donde cazamos.
import { geoNaturalEarth1, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
import world from 'world-atlas/countries-110m.json';
import { programs } from '../data/programs.js';
import { u } from '../lib/url.js';

// slug de país -> [nombre en world-atlas, lon, lat del punto]
const GEO = {
  argentina: ['Argentina', -64, -37], austria: ['Austria', 14.5, 47.5], azerbaiyan: ['Azerbaijan', 47.7, 40.3],
  benin: ['Benin', 2.3, 9.6], bielorrusia: ['Belarus', 28, 53.5], botswana: ['Botswana', 24, -22],
  bulgaria: ['Bulgaria', 25.3, 42.7], camerun: ['Cameroon', 12.5, 6], canada: ['Canada', -100, 56],
  croacia: ['Croatia', 15.8, 45.3], eeuu: ['United States of America', -153, 58], escocia: ['United Kingdom', -4.2, 57],
  eslovenia: ['Slovenia', 14.8, 46.1], espana: ['Spain', -3.7, 40.2], francia: ['France', 2.5, 46.5],
  groenlandia: ['Greenland', -50.7, 67], hungria: ['Hungary', 19.4, 47.1], inglaterra: ['United Kingdom', -0.8, 52.6],
  iran: ['Iran', 53.7, 32.4], italia: ['Italy', 7.4, 45.2], kazakhstan: ['Kazakhstan', 67, 48],
  kirguizia: ['Kyrgyzstan', 74.6, 41.4], macedonia: ['Macedonia', 21.7, 41.6], mauritania: ['Mauritania', -11, 17],
  mongolia: ['Mongolia', 103, 46.8], mozambique: ['Mozambique', 35.5, -18.5], namibia: ['Namibia', 17, -22.5],
  'nueva-zelanda': ['New Zealand', 170.5, -44], polonia: ['Poland', 19.4, 52], rumania: ['Romania', 25, 45.9],
  rusia: ['Russia', 135, 58], sudafrica: ['South Africa', 25, -29], tanzania: ['Tanzania', 35, -6.5],
  tayikistan: ['Tajikistan', 71.3, 38.8], tunez: ['Tunisia', 9.5, 34], turquia: ['Turkey', 35, 39],
  zambia: ['Zambia', 27.8, -13.5], zimbabwe: ['Zimbabwe', 29.8, -19], australia: ['Australia', 134, -13],
};

const W = 1000, H = 500;
const land = feature(world, world.objects.countries).features.filter((f) => f.properties.name !== 'Antarctica');
const proj = geoNaturalEarth1().fitExtent([[4, 4], [W - 4, H - 4]], { type: 'FeatureCollection', features: land });
const path = geoPath(proj);

// Países con programas: enlace a la caza con rifle si existe, si no a la de arco.
const byCountry = new Map();
for (const p of programs) {
  const c = byCountry.get(p.country) ?? { slug: p.country, name: p.countryName, cats: new Set(), n: 0 };
  c.cats.add(p.category); c.n++; byCountry.set(p.country, c);
}
const pins = [...byCountry.values()].filter((c) => GEO[c.slug]).map((c) => {
  const cat = [...c.cats].find((k) => k !== 'caza-con-arco') ?? 'caza-con-arco';
  const [x, y] = proj([GEO[c.slug][1], GEO[c.slug][2]]);
  return { ...c, href: u(`${cat}/${c.slug}`), x, y, arco: c.cats.has('caza-con-arco') };
});
const hunted = new Set(pins.map((p) => GEO[p.slug][0]));
---
<div class="wmap">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Mapa de los países donde cazamos">
    <g class="land">
      {land.map((f) => <path d={path(f)} class:list={[{ on: hunted.has(f.properties.name) }]} />)}
    </g>
    <g class="pins">
      {pins.map((p) => (
        <a href={p.href} aria-label={p.name}>
          <title>{`${p.name} · ${p.n} ${p.n === 1 ? 'programa' : 'programas'}${p.arco ? ' · también con arco' : ''}`}</title>
          <circle class="halo" cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="9" />
          <circle class="dot" cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="3.6" />
          <text x={(p.x + 7).toFixed(1)} y={(p.y + 3.5).toFixed(1)}>{p.name}</text>
        </a>
      ))}
    </g>
  </svg>
  <p class="wmap-note">{pins.length} países en los cinco continentes. Pulsa un punto para ver sus programas.</p>
</div>

<style>
  .wmap svg { width: 100%; height: auto; display: block; }
  .land path { fill: var(--char-2); stroke: var(--black); stroke-width: .5; }
  .land path.on { fill: rgba(191, 18, 29, .28); }
  .land { pointer-events: none; }
  .pins a { cursor: pointer; }
  .pins .dot { fill: var(--red); stroke: #fff; stroke-width: 1.2; }
  .pins .halo { fill: var(--red); opacity: 0; transition: opacity .2s; }
  .pins text { font: 500 11px var(--body, sans-serif); fill: var(--bone); opacity: 0; pointer-events: none; paint-order: stroke; stroke: var(--black); stroke-width: 3px; transition: opacity .2s; }
  .pins a:hover .halo, .pins a:focus .halo { opacity: .25; }
  .pins a:hover text, .pins a:focus text { opacity: 1; }
  .wmap-note { margin: 14px 0 0; text-align: center; color: var(--stone); font-size: 14px; }
</style>
