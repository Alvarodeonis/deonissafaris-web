---
// Mapa del mundo estático (SVG generado en el build) con los países donde cazamos.
import { geoNaturalEarth1, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
import world from 'world-atlas/countries-110m.json';
import { programs } from '../data/programs.js';
import { u } from '../lib/url.js';

import { GEO } from '../data/geo.js';

const W = 1000, H = 500;
const land = feature(world, world.objects.countries).features.filter((f) => f.properties.name !== 'Antarctica');
const proj = geoNaturalEarth1().fitExtent([[4, 4], [W - 4, H - 4]], { type: 'FeatureCollection', features: land });
const path = geoPath(proj);

// Países con programas: enlace a la caza con rifle si existe, si no a la de arco.
const byCountry = new Map();
for (const p of programs) {
  const c = byCountry.get(p.country) ?? { slug: p.country, name: p.countryName, cats: new Set(), n: 0 };
  c.cats.add(p.category); c.n++; byCountry.set(p.country, c);
}
const pins = [...byCountry.values()].filter((c) => GEO[c.slug]).map((c) => {
  const cat = [...c.cats].find((k) => k !== 'caza-con-arco') ?? 'caza-con-arco';
  const [x, y] = proj([GEO[c.slug][1], GEO[c.slug][2]]);
  return { ...c, href: u(`${cat}/${c.slug}`), x, y, arco: c.cats.has('caza-con-arco') };
});
const hunted = new Set(pins.map((p) => GEO[p.slug][0]));
---
<div class="wmap">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Mapa de los países donde cazamos">
    <g class="land">
      {land.map((f) => <path d={path(f)} class:list={[{ on: hunted.has(f.properties.name) }]} />)}
    </g>
    <g class="pins">
      {pins.map((p) => (
        <a href={p.href} aria-label={p.name}>
          <circle class="halo" cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="9" />
          <circle class="dot" cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="3.6" />
          <text x={p.x.toFixed(1)} y={(p.y - 14).toFixed(1)} text-anchor="middle" style={`transform-origin:${p.x.toFixed(1)}px ${p.y.toFixed(1)}px`}><tspan class="nm">{p.name}</tspan><tspan class="np" x={p.x.toFixed(1)} dy="13">{`${p.n} ${p.n === 1 ? 'programa' : 'programas'}`}</tspan></text>
        </a>
      ))}
    </g>
  </svg>
  <p class="wmap-note">Pulsa un punto para ver los programas de cada país.</p>
</div>

<style>
  .wmap svg { width: 100%; height: auto; display: block; overflow: visible; }
  .land path { fill: rgba(255,255,255,.09); stroke: #0d0e0d; stroke-width: .6; }
  .land path.on { fill: rgba(191, 18, 29, .78); }
  .land { pointer-events: none; }
  .pins a { cursor: pointer; }
  .pins .dot { fill: #fff; stroke: #0d0e0d; stroke-width: 1; transition: r .2s, fill .2s; }
  .pins a:hover .dot, .pins a:focus .dot { r: 5.5; fill: var(--red); stroke: #fff; }
  .pins .halo { fill: #fff; opacity: 0; transition: opacity .2s; }
  .pins text { font: 500 11px var(--body, sans-serif); transform: scale(.6); transition: opacity .2s, transform .25s; fill: #fff; opacity: 0; pointer-events: none; paint-order: stroke; stroke: #0d0e0d; stroke-width: 3px; }
  .pins a:hover .halo, .pins a:focus .halo { opacity: .25; }
  .pins a:hover text, .pins a:focus text { opacity: 1; transform: scale(1); }
  .pins .nm { font: 500 20px var(--display); }
  .pins .np { font: 500 9px var(--label); letter-spacing: .14em; text-transform: uppercase; }
  .pins a:hover { position: relative; z-index: 2; }
  .wmap-note { margin: 14px 0 0; text-align: center; color: var(--stone); font-size: 14px; }
</style>
