---
// Mapamundi pequeño con el país del programa resaltado (el SVG se genera una vez por país
// en src/pages/mapas/[country].svg.js y lo comparten todas las fichas e idiomas).
import { GEO } from '../data/geo.js';
import { raw } from '../lib/url.js';

const { country, name } = Astro.props;
const g = GEO[country];
---
{g && (
  <figure class="pmap">
    <img src={raw(`mapas/${country}.svg`)} width="1000" height="500" alt={`Mapa: ${name}`} loading="lazy" />
    <figcaption><b>{name}</b></figcaption>
  </figure>
)}

<style>
  .pmap { position: relative; margin: 0; padding: 8px 10px 6px; border: 1px solid var(--line); border-radius: 14px; background: rgba(255,255,255,.02); }
  .pmap img { width: 100%; height: auto; display: block; }
  .pmap figcaption { position: absolute; left: 12px; bottom: 8px; max-width: 30%; line-height: 1.25; }
  .pmap b { font: 500 16px var(--display); }
</style>
