---
// Bloque de texto SEO al final de la página: guía en columnas + preguntas frecuentes.
import { u } from '../lib/url.js';
const { data } = Astro.props;
const md = (s) => s.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_, t, href) => `<a href="${u(href)}">${t}</a>`);
---
{data && (
  <section class="seo">
    <div class="wrap">
      <h2>{data.heading}</h2>
      <div class="cols">
        {data.sections.map((s) => (
          <div>
            <h3>{s.h}</h3>
            {s.p.map((p) => <p set:html={md(p)} />)}
          </div>
        ))}
      </div>
      {data.faq?.length > 0 && (
        <div class="faq">
          <h2>Preguntas frecuentes</h2>
          {data.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p set:html={md(f.a)} />
            </details>
          ))}
        </div>
      )}
    </div>
  </section>
)}

<style>
  .seo { margin-top: 72px; padding: 56px 0 24px; border-top: 1px solid var(--line); }
  .seo h2 { font-size: clamp(28px, 2.6vw, 40px); margin: 0 0 24px; }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 12px 40px; }
  .seo h3 { font: 500 22px/1.2 var(--display); margin: 0 0 10px; color: var(--bone); }
  .seo p { margin: 0 0 12px; font-size: 15px; line-height: 1.65; color: var(--stone); }
  .seo p :global(a) { color: var(--red-hi); text-decoration: none; border-bottom: 1px solid currentColor; }
  .faq { margin-top: 40px; max-width: 860px; }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; padding: 14px 32px 14px 0; position: relative; font: 500 18px/1.3 var(--display); color: var(--bone); }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 4px; top: 12px; font: 400 22px var(--label); color: var(--red-hi); }
  details[open] summary::after { content: '–'; }
  details p { padding-right: 32px; }
</style>
