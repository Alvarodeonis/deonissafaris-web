---
import Layout from '../layouts/Layout.astro';
import { contact } from '../data/site.js';
import { u } from '../lib/url.js';
import { filmGroups, allFilms, featuredFilms } from '../data/films.js';
import frames from '../data/frames.json';

const first = featuredFilms[0];
const thumb = (id, n = 'hqdefault') => `https://i.ytimg.com/vi/${id}/${n}.jpg`;
---
<Layout
  title="Películas de caza internacional"
  description={`${allFilms.length} películas de nuestras cacerías: búfalo y leopardo en Mozambique, leones en el Kalahari, ciervos de récord en Nueva Zelanda, osos en Rumanía y Siberia, jabalíes en Irán y Turquía, buey almizclero en Groenlandia y caza con arco.`}>
  <section class="films-top">
    <div class="wrap">
      <div class="crumbs"><a href={u()}>Inicio</a><span>/</span>Películas</div>
      <div class="ft-head">
        <h1>Películas de caza</h1>
        <p>{allFilms.length} películas rodadas en nuestras propias cacerías por todo el mundo, muchas emitidas en Iberalia TV.</p>
      </div>

      <div class="stage">
        <div class="player">
          <div class="frame" id="frame"><button type="button" class="poster" id="poster-btn" data-play={first.id} data-title={first.title} data-group={first.groupName} aria-label={`Ver ${first.title}`}>
            <img id="poster" src={thumb(first.id, 'maxresdefault')} alt={first.title} onerror="this.onerror=null;this.src=this.src.replace('maxresdefault','hqdefault')" />
            <span class="bigplay" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>
          </button></div>
          <div class="now"><span class="eyebrow" id="now-group">{first.groupName}</span><h2 id="now-title">{first.title}</h2></div>
        </div>
        <aside class="recs">
          <div class="eyebrow">Recomendadas</div>
          {featuredFilms.map((f, i) => (
            <button type="button" class:list={['rec', { on: i === 0 }]} data-play={f.id} data-title={f.title} data-group={f.groupName}>
              <span class="rth" data-hover={f.id} data-frames={frames[f.id] ?? 0}><img src={thumb(f.id, 'mqdefault')} alt={f.title} loading="lazy" /></span>
              <span class="rtx"><small>{f.groupName}</small>{f.title}</span>
            </button>
          ))}
        </aside>
      </div>
    </div>
  </section>

  <section class="films-all">
    <div class="wrap">
      <div class="eyebrow">Todas las películas</div>
      <nav class="ffilter" aria-label="Filtrar por país">
        <button type="button" class="on" data-f="all"><b>Todas</b><small>{allFilms.length} películas</small></button>
        {filmGroups.map((g) => <button type="button" data-f={g.slug}><b>{g.name}</b><small>{g.films.length} {g.films.length === 1 ? 'película' : 'películas'}</small></button>)}
      </nav>
      {filmGroups.map((g) => (
        <div class="fgroup" data-g={g.slug}>
          <h3>{g.name}</h3>
          <div class="flist">
            {g.films.map((f) => (
              <button type="button" class="film-card" data-play={f.id} data-title={f.title} data-group={g.name}>
                <span class="th" data-hover={f.id} data-frames={frames[f.id] ?? 0}><img src={thumb(f.id, 'maxresdefault')} alt={f.title} loading="lazy" onload="if(this.naturalWidth<200&&/maxres/.test(this.src))this.src=this.src.replace('maxresdefault','hqdefault')" onerror="this.onerror=null;this.src=this.src.replace('maxresdefault','hqdefault')" /><span class="bar" aria-hidden="true"></span><span class="pl" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span></span>
                <span class="ftl">{f.title}</span>
              </button>
            ))}
          </div>
        </div>
      ))}
      <p class="yt"><a class="btn outline" href={contact.social.youtube} target="_blank" rel="noopener">Nuestro canal de YouTube</a></p>
    </div>
  </section>
  <div class="vmodal" id="vmodal" hidden role="dialog" aria-modal="true" aria-labelledby="vm-title">
    <div class="vm-box">
      <div class="vm-top">
        <div><small id="vm-group"></small><h2 id="vm-title"></h2></div>
        <button type="button" class="vm-close" id="vm-close" aria-label="Cerrar">Cerrar <kbd>Esc</kbd></button>
      </div>
      <div class="vm-frame" id="vm-frame"></div>
      <div class="vm-nav">
        <button type="button" id="vm-prev">‹ Anterior</button>
        <button type="button" id="vm-next">Siguiente ›</button>
      </div>
    </div>
  </div>
</Layout>

<style>
  .films-top { padding-top: calc(var(--page-top) - 30px); padding-bottom: 30px; }
  .ft-head { display: flex; justify-content: space-between; align-items: end; gap: 12px 40px; flex-wrap: wrap; margin: 14px 0 22px; }
  .ft-head h1 { font-size: clamp(38px, 4.4vw, 64px); margin: 0; line-height: 1; }
  .ft-head p { margin: 0; max-width: 52ch; color: var(--stone); }
  .stage { display: grid; grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr); gap: 22px; align-items: start; }
  .frame { aspect-ratio: 16 / 9; background: #000; }
  .frame :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .poster { position: relative; display: block; width: 100%; height: 100%; padding: 0; background: #000; border: 0; cursor: pointer; overflow: hidden; }
  .poster img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .8s ease, filter .4s; }
  .poster::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 50%, rgba(0,0,0,.45)); }
  .poster:hover img { transform: scale(1.03); filter: brightness(1.05); }
  .bigplay { position: absolute; z-index: 1; inset: 0; margin: auto; width: 88px; height: 88px; border-radius: 50%; background: var(--red); display: grid; place-items: center; box-shadow: 0 10px 40px rgba(0,0,0,.45); transition: transform .3s; }
  .bigplay svg { width: 40%; fill: #fff; margin-left: 5px; }
  .poster:hover .bigplay { transform: scale(1.1); }
  .now { margin-top: 14px; }
  .now h2 { font-size: clamp(24px, 2.2vw, 32px); margin: 6px 0 0; }
  .recs { display: grid; gap: 10px; }
  .rec { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 12px; align-items: center; padding: 6px; background: none; border: 1px solid transparent; text-align: left; color: var(--bone); cursor: pointer; transition: .2s; }
  .rec:hover, .rec.on { background: var(--char); border-color: var(--line); }
  .rec.on { box-shadow: inset 3px 0 0 var(--red); }
  .rth { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--char-2); }
  .rth img, .th img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .rtx { font: 500 17px/1.2 var(--display); }
  .rtx small { display: block; margin-bottom: 4px; font: 500 10px var(--label); letter-spacing: .16em; text-transform: uppercase; color: var(--red); }
  .films-all { padding-top: 20px; }
  .ffilter { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; margin: 14px 0 10px; }
  .ffilter button { text-align: left; padding: 12px 14px 10px; background: var(--char); border: 1px solid rgba(28,27,24,.22); border-top: 3px solid var(--red); color: var(--bone); cursor: pointer; transition: .2s; }
  .ffilter b { display: block; font: 500 20px/1.1 var(--display); }
  .ffilter small { display: block; margin-top: 4px; font: 500 10px var(--label); letter-spacing: .14em; text-transform: uppercase; color: var(--stone); }
  .ffilter button:hover, .ffilter button.on { background: var(--red); border-color: var(--red); color: #fff; }
  .ffilter button:hover small, .ffilter button.on small { color: rgba(255,255,255,.8); }
  .fgroup { margin: 34px 0 0; }
  .fgroup[hidden] { display: none; }
  .fgroup h3 { font-size: 30px; margin: 0 0 14px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  .flist { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr)); gap: 26px 18px; }
  .film-card { display: flex; flex-direction: column; justify-content: flex-start; border: 0; padding: 0; background: none; text-align: left; cursor: pointer; color: var(--bone); }
  .th { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--char); }
  .pl { position: absolute; inset: 0; margin: auto; width: 48px; height: 48px; border-radius: 50%; background: rgba(0,0,0,.45); border: 1px solid rgba(255,255,255,.7); display: grid; place-items: center; transition: .25s; }
  /* Avance al pasar el ratón: fotogramas del vídeo que se funden con un zoom lento. */
  .th :global(img.fr), .rth :global(img.fr) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .25s ease; }
  .th :global(img.fr.on), .rth :global(img.fr.on) { opacity: 1; }
  .bar { position: absolute; z-index: 2; left: 0; bottom: 0; height: 3px; width: 0; background: var(--red); }
  .film-card:hover .bar { width: 100%; transition: width var(--len, 16s) linear; }
  .film-card:hover .pl { background: var(--red); border-color: var(--red); transform: scale(1.12); }
  .pl { z-index: 2; }
  .pl svg { width: 45%; fill: #fff; margin-left: 3px; }
  .ftl { display: block; margin-top: 10px; font: 500 19px/1.25 var(--display); }
  .yt { margin-top: 48px; text-align: center; }
  .vmodal { position: fixed; inset: 0; z-index: 210; display: grid; place-items: center; padding: 20px; background: rgba(8,7,6,.94); opacity: 0; transition: opacity .25s; }
  .vmodal.on { opacity: 1; }
  .vmodal[hidden] { display: none; }
  .vm-box { width: min(1200px, 100%, calc((100vh - 170px) * 16 / 9)); color: #fff; transform: translateY(12px) scale(.98); transition: transform .3s; }
  .vmodal.on .vm-box { transform: none; }
  .vm-top { display: flex; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: 12px; }
  .vm-top small { font: 500 10px var(--label); letter-spacing: .2em; text-transform: uppercase; color: #ff6b6b; }
  .vm-top h2 { margin: 4px 0 0; font-size: clamp(22px, 2.4vw, 34px); color: #fff; }
  .vm-close, .vm-nav button { background: none; border: 0; color: rgba(255,255,255,.8); font: 500 11px var(--label); letter-spacing: .2em; text-transform: uppercase; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; }
  .vm-close:hover, .vm-nav button:hover { color: #fff; }
  .vm-close kbd { border: 1px solid rgba(255,255,255,.3); padding: 2px 6px; font: inherit; }
  .vm-frame { aspect-ratio: 16 / 9; background: #000; box-shadow: 0 30px 80px rgba(0,0,0,.6); }
  .vm-frame :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .vm-nav { display: flex; justify-content: space-between; margin-top: 12px; }
  html.vm-lock { overflow: hidden; }
  @media (max-width: 600px) { .vm-close kbd { display: none; } .vmodal { padding: 12px; } }
  @media (max-width: 960px) {
    .stage { grid-template-columns: 1fr; }
    .rec { grid-template-columns: 120px minmax(0, 1fr); }
  }
</style>

<script>
  const yt = (id: string) => `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&playsinline=1&vq=hd1080`;
  const iframe = (id: string, title: string) => {
    const f = document.createElement('iframe');
    f.src = yt(id); f.title = title;
    f.allow = 'autoplay; fullscreen; encrypted-media; picture-in-picture';
    f.allowFullscreen = true;
    return f;
  };

  // Reproductor destacado: se carga YouTube solo al pulsar (la página abre más rápido).
  const frame = document.getElementById('frame')!;
  const stagePlay = (id: string, title: string, group: string, autoplay = true) => {
    document.getElementById('now-title')!.textContent = title;
    document.getElementById('now-group')!.textContent = group;
    document.querySelectorAll<HTMLElement>('.rec').forEach((r) => r.classList.toggle('on', r.dataset.play === id));
    if (autoplay) frame.replaceChildren(iframe(id, title));
  };
  const pb = document.getElementById('poster-btn')!;
  pb.addEventListener('click', () => stagePlay(pb.dataset.play!, pb.dataset.title!, pb.dataset.group!));
  document.querySelectorAll<HTMLElement>('.rec').forEach((b) => b.addEventListener('click', () => stagePlay(b.dataset.play!, b.dataset.title!, b.dataset.group!)));

  // Resto de películas: se abren en grande en una ventana, con anterior y siguiente.
  const modal = document.getElementById('vmodal')!;
  const mFrame = document.getElementById('vm-frame')!;
  // Solo las tarjetas de películas (el pie de página también tiene tarjetas .film-card de redes sociales).
  const cards = [...document.querySelectorAll<HTMLElement>('.fgroup .film-card[data-play]')];
  let cur = -1;
  const visible = () => cards.filter((c) => !c.closest<HTMLElement>('.fgroup')?.hidden);
  const open = (c: HTMLElement) => {
    cur = visible().indexOf(c);
    document.getElementById('vm-title')!.textContent = c.dataset.title!;
    document.getElementById('vm-group')!.textContent = c.dataset.group!;
    mFrame.replaceChildren(iframe(c.dataset.play!, c.dataset.title!));
    if (modal.hidden) { modal.hidden = false; document.documentElement.classList.add('vm-lock'); requestAnimationFrame(() => modal.classList.add('on')); }
  };
  const close = () => { modal.classList.remove('on'); document.documentElement.classList.remove('vm-lock'); mFrame.replaceChildren(); setTimeout(() => { modal.hidden = true; }, 250); };
  const step = (n: number) => { const v = visible(); if (v.length) open(v[(cur + n + v.length) % v.length]); };
  cards.forEach((c) => c.addEventListener('click', () => open(c)));
  document.getElementById('vm-close')!.addEventListener('click', close);
  document.getElementById('vm-prev')!.addEventListener('click', () => step(-1));
  document.getElementById('vm-next')!.addEventListener('click', () => step(1));
  modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
  document.addEventListener('keydown', (e) => {
    if (modal.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowRight') step(1);
    if (e.key === 'ArrowLeft') step(-1);
  });

  // Avance al pasar el ratón: fotogramas reales de la película (sin la intro), unos 2,5 s cada uno.
  const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
  const HOLD = 2500;
  document.querySelectorAll<HTMLElement>('[data-hover]').forEach((el) => {
    const id = el.dataset.hover!;
    const n = Number(el.dataset.frames || 0);
    // Sin fotogramas propios: las 3 miniaturas automáticas de YouTube (al 25, 50 y 75 % del vídeo, nunca la intro).
    const srcs = n ? Array.from({ length: n }, (_, k) => `${base}img/frames/${id}-${k + 1}.jpg`) : [1, 2, 3].map((k) => `https://i.ytimg.com/vi/${id}/sd${k}.jpg`);
    el.style.setProperty('--len', `${(srcs.length * HOLD) / 1000}s`);
    // Una sola capa encima de la miniatura: cambia de fotograma de golpe, sin fundidos ni zoom,
    // para que nunca se vean dos imágenes superpuestas.
    let frames: string[] = [], ov: HTMLImageElement | null = null, t: number | undefined, i = 0, over = false;
    const prep = () => {
      if (ov) return;
      ov = document.createElement('img');
      ov.className = 'fr'; ov.alt = ''; ov.decoding = 'async';
      el.insertBefore(ov, el.querySelector('.bar') ?? el.querySelector('.pl'));
      // Fotogramas de 640 px; si el vídeo no los tiene, los de 480 px. YouTube devuelve una imagen gris
      // de 120 px cuando no existe, así que se mira también el tamaño. Se quitan los que fallan.
      frames = srcs.map(() => '');
      srcs.forEach((src, k) => {
        const pre = new Image();
        const low = () => { if (/\/sd\d\.jpg$/.test(pre.src)) { pre.src = pre.src.replace(/\/sd(\d)\.jpg$/, '/hq$1.jpg'); return; } frames[k] = ''; };
        pre.onload = () => { if (!n && pre.naturalWidth < 200) low(); else frames[k] = pre.src; };
        pre.onerror = low;
        pre.src = src;
      });
    };
    const show = () => {
      if (!over || !ov) return;
      const ok = frames.filter(Boolean);
      if (!ok.length) { t = window.setTimeout(show, 150); return; }
      ov.src = ok[i % ok.length]; ov.classList.add('on'); i++;
      t = window.setTimeout(show, HOLD);
    };
    el.addEventListener('mouseenter', () => {
      prep(); over = true; i = 0; clearTimeout(t);
      t = window.setTimeout(show, 150);
    });
    el.addEventListener('mouseleave', () => { over = false; clearTimeout(t); ov?.classList.remove('on'); });
  });

  const btns = document.querySelectorAll<HTMLElement>('.ffilter button');
  const groups = document.querySelectorAll<HTMLElement>('.fgroup');
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => x.classList.toggle('on', x === b));
    groups.forEach((g) => { g.hidden = b.dataset.f !== 'all' && g.dataset.g !== b.dataset.f; });
  }));
</script>
