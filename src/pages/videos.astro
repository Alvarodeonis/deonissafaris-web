---
import Layout from '../layouts/Layout.astro';
import VideoGrid from '../components/VideoGrid.astro';
import { contact } from '../data/site.js';
import { filmGroups, allFilms, featuredFilms } from '../data/films.js';
---
<Layout title="Películas" description="Todas las películas de nuestras cacerías, por países.">
  <section class="films-head">
    <div class="wrap">
      <div class="sec-head">
        <div><div class="eyebrow">En el campo</div><h2>Películas de caza</h2></div>
        <p class="lead">{allFilms.length} películas rodadas en nuestras cacerías, muchas con Iberalia TV. Empieza por nuestras recomendadas o elige un país.</p>
      </div>
      <div class="eyebrow rec">Recomendadas</div>
      <VideoGrid videos={featuredFilms} />
    </div>
  </section>

  <section class="films-all">
    <div class="wrap">
      <nav class="ffilter" aria-label="Filtrar por país">
        <button type="button" class="on" data-f="all">Todas <i>{allFilms.length}</i></button>
        {filmGroups.map((g) => <button type="button" data-f={g.slug}>{g.name} <i>{g.films.length}</i></button>)}
      </nav>
      {filmGroups.map((g) => (
        <div class="fgroup" data-g={g.slug}>
          <h3>{g.name}</h3>
          <div class="flist">
            {g.films.map((f) => (
              <button type="button" class="fcard" data-yt={f.id}>
                <span class="th"><img src={`https://i.ytimg.com/vi/${f.id}/hqdefault.jpg`} alt="" loading="lazy" /><span class="pl" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span></span>
                <span class="ft">{f.title}</span>
              </button>
            ))}
          </div>
        </div>
      ))}
      <p class="yt"><a class="btn outline" href={contact.social.youtube} target="_blank" rel="noopener">Nuestro canal de YouTube</a></p>
    </div>
  </section>
</Layout>

<style>
  .films-head { padding-top: 150px; }
  .rec { margin: 8px 0 14px; }
  .films-all { padding-top: 10px; }
  .ffilter { display: flex; flex-wrap: wrap; gap: 8px; padding: 14px 0; margin-bottom: 18px; background: var(--black); border-bottom: 1px solid var(--line); }
  .ffilter button { font: 500 11px var(--label); letter-spacing: .14em; text-transform: uppercase; padding: 9px 14px; background: none; color: var(--bone); border: 1px solid var(--line); cursor: pointer; transition: .2s; }
  .ffilter button i { font-style: normal; color: var(--stone); margin-left: 4px; }
  .ffilter button:hover, .ffilter button.on { background: var(--red); border-color: var(--red); color: #fff; }
  .ffilter button.on i, .ffilter button:hover i { color: rgba(255,255,255,.75); }
  .fgroup { margin: 34px 0 0; }
  .fgroup[hidden] { display: none; }
  .fgroup h3 { font-size: 30px; margin: 0 0 14px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  .flist { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 22px 16px; }
  .fcard { border: 0; padding: 0; background: none; text-align: left; cursor: pointer; color: var(--bone); }
  .th { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--char); }
  .th img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
  .fcard:hover .th img { transform: scale(1.05); }
  .pl { position: absolute; inset: 0; margin: auto; width: 48px; height: 48px; border-radius: 50%; background: rgba(0,0,0,.45); border: 1px solid rgba(255,255,255,.7); display: grid; place-items: center; transition: .25s; }
  .fcard:hover .pl { background: var(--red); border-color: var(--red); }
  .pl svg { width: 45%; fill: #fff; margin-left: 3px; }
  .ft { display: block; margin-top: 10px; font: 500 19px/1.25 var(--display); }
  .yt { margin-top: 48px; text-align: center; }
</style>

<script>
  const btns = document.querySelectorAll('.ffilter button');
  const groups = document.querySelectorAll('.fgroup');
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => x.classList.toggle('on', x === b));
    groups.forEach((g) => { g.hidden = b.dataset.f !== 'all' && g.dataset.g !== b.dataset.f; });
  }));
</script>
