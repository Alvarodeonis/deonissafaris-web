---
import Layout from '../layouts/Layout.astro';
import VideoGrid from '../components/VideoGrid.astro';
import { videos, contact } from '../data/site.js';
---
<Layout title="Vídeos" description="Vídeos de nuestras cacerías en África, Asia, Europa y América.">
  <section style="padding-top:200px">
    <div class="wrap">
      <div class="sec-head">
        <div><div class="eyebrow">En el campo</div><h2>Vídeos de caza</h2></div>
        <a class="btn outline" href={contact.social.youtube} target="_blank" rel="noopener">Nuestro canal de YouTube</a>
      </div>
      <VideoGrid videos={videos} />
    </div>
  </section>
</Layout>
