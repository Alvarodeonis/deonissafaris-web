---
import Layout from '../layouts/Layout.astro';
import { contact } from '../data/site.js';
import { u } from '../lib/url.js';
import { filmGroups, allFilms, featuredFilms } from '../data/films.js';
import frames from '../data/frames.json';

const first = featuredFilms[0];
const thumb = (id, n = 'hqdefault') => `https://i.ytimg.com/vi/${id}/${n}.jpg`;
---
<Layout
  title="Películas de caza internacional"
  description={`${allFilms.length} películas de nuestras cacerías: búfalo y leopardo en Mozambique, leones en el Kalahari, ciervos de récord en Nueva Zelanda, osos en Rumanía y Siberia, jabalíes en Irán y Turquía, buey almizclero en Groenlandia y caza con arco.`}>
  <section class="dark nf-hero" id="bb" aria-label="Película destacada">
    {featuredFilms.map((f, i) => (
      <img class:list={['bb-img', { on: i === 0 }]} src={thumb(f.id, 'maxresdefault')} alt="" fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? undefined : 'lazy'} onerror="this.onerror=null;this.src=this.src.replace('maxresdefault','hqdefault')" />
    ))}
    <div class="bb-shade" aria-hidden="true"></div>
    <div class="wrap bb-in">
      <div class="crumbs"><a href={u()}>Inicio</a><span>/</span>Películas</div>
      <h1 class="bb-h1">Películas de caza <span>{allFilms.length} películas</span></h1>
      <div class="bb-txt">
        <div class="eyebrow" id="bb-group">{first.groupName}</div>
        <h2 id="bb-title">{first.title}</h2>
        <p>{allFilms.length} películas rodadas en nuestras propias cacerías por todo el mundo, muchas emitidas en Iberalia TV.</p>
        <div class="bb-act">
          <button type="button" class="bb-play" id="bb-play"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>Ver película</button>
          <div class="bb-dots">{featuredFilms.map((f, i) => <button type="button" class:list={{ on: i === 0 }} data-i={i} aria-label={f.title}></button>)}</div>
        </div>
      </div>
    </div>
  </section>

  <section class="dark nf-rows">
    {[{ name: 'Recomendadas', slug: 'recomendadas', films: featuredFilms }, ...filmGroups].map((g) => (
      <div class="fgroup" data-g={g.slug}>
        <div class="wrap row-h"><h3>{g.name}</h3><small>{g.films.length} {g.films.length === 1 ? 'película' : 'películas'}</small></div>
        <div class="row">
          <button type="button" class="ra prev" aria-label="Anterior" hidden><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7" /></svg></button>
          <div class="flist">
            {g.films.map((f) => (
              <button type="button" class="film-card" data-play={f.id} data-title={f.title} data-group={f.groupName ?? g.name}>
                <span class="th" data-hover={f.id} data-frames={frames[f.id] ?? 0}><img src={thumb(f.id, 'maxresdefault')} alt={f.title} loading="lazy" onload="if(this.naturalWidth<200&&/maxres/.test(this.src))this.src=this.src.replace('maxresdefault','hqdefault')" onerror="this.onerror=null;this.src=this.src.replace('maxresdefault','hqdefault')" /><span class="bar" aria-hidden="true"></span><span class="pl" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span></span>
                <span class="ftl">{f.title}</span>
              </button>
            ))}
          </div>
          <button type="button" class="ra next" aria-label="Siguiente" hidden><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" /></svg></button>
        </div>
      </div>
    ))}
    <p class="yt"><a class="btn outline" href={contact.social.youtube} target="_blank" rel="noopener">Nuestro canal de YouTube</a></p>
  </section>
  <div class="vmodal" id="vmodal" hidden role="dialog" aria-modal="true" aria-labelledby="vm-title">
    <div class="vm-box">
      <div class="vm-top">
        <div><small id="vm-group"></small><h2 id="vm-title"></h2></div>
        <button type="button" class="vm-close" id="vm-close" aria-label="Cerrar">Cerrar <kbd>Esc</kbd></button>
      </div>
      <div class="vm-frame" id="vm-frame"></div>
      <div class="vm-nav">
        <button type="button" id="vm-prev">‹ Anterior</button>
        <button type="button" id="vm-next">Siguiente ›</button>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Portada tipo Netflix: película destacada a todo ancho y una fila deslizable por país. */
  .nf-hero { position: relative; overflow: hidden; min-height: min(92vh, 56.25vw + 60px); display: flex; align-items: flex-end; background: #0b0a09; }
  .bb-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 1.2s ease; }
  .bb-img.on { opacity: 1; }
  .bb-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(11,10,9,.88) 0%, rgba(11,10,9,.55) 38%, rgba(11,10,9,0) 70%), linear-gradient(180deg, rgba(11,10,9,.7) 0%, rgba(11,10,9,0) 30%, rgba(11,10,9,0) 62%, #0b0a09 100%); }
  .bb-in { position: relative; z-index: 1; width: 100%; padding-top: var(--page-top); padding-bottom: clamp(40px, 6vw, 90px); }
  .bb-in .crumbs { color: rgba(255,255,255,.7); }
  .bb-h1 { margin: 10px 0 0; font: 500 12px var(--label); letter-spacing: .22em; text-transform: uppercase; color: rgba(255,255,255,.75); }
  .bb-h1 span { margin-left: 10px; color: rgba(255,255,255,.5); }
  .bb-txt { max-width: 640px; margin-top: clamp(30px, 7vh, 90px); }
  .bb-txt .eyebrow { color: #ff6b6b; }
  .bb-txt h2 { margin: 8px 0 14px; font-size: clamp(36px, 5vw, 72px); line-height: 1; color: #fff; text-shadow: 0 2px 30px rgba(0,0,0,.5); }
  .bb-txt p { margin: 0 0 24px; color: rgba(255,255,255,.85); max-width: 48ch; }
  .bb-act { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  .bb-play { display: inline-flex; align-items: center; gap: 10px; padding: 14px 28px 14px 22px; background: #fff; color: #111; border: 0; font: 500 13px var(--label); letter-spacing: .18em; text-transform: uppercase; cursor: pointer; transition: .2s; }
  .bb-play svg { width: 22px; fill: currentColor; }
  .bb-play:hover { background: var(--red); color: #fff; }
  .bb-dots { display: flex; gap: 8px; }
  .bb-dots button { width: 26px; height: 3px; padding: 0; border: 0; background: rgba(255,255,255,.35); cursor: pointer; }
  .bb-dots button.on { background: var(--red); }
  .nf-rows { background: #0b0a09; padding: 0 0 70px; }
  .fgroup { margin-top: 38px; }
  .fgroup:first-child { margin-top: 0; }
  .row-h { display: flex; align-items: baseline; gap: 14px; margin-bottom: 12px; }
  .row-h h3 { margin: 0; font-size: clamp(24px, 2.2vw, 32px); color: #fff; }
  .row-h small { font: 500 10px var(--label); letter-spacing: .16em; text-transform: uppercase; color: var(--stone); }
  .row { position: relative; }
  .flist { display: grid; grid-auto-flow: column; grid-auto-columns: clamp(250px, 24vw, 380px); gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; --side: max(var(--gutter), calc((100% - var(--wrap)) / 2 + var(--gutter))); scroll-padding-inline: var(--side); padding: 10px var(--side) 14px; scrollbar-width: none; }
  .flist::-webkit-scrollbar { display: none; }
  .film-card { scroll-snap-align: start; display: flex; flex-direction: column; justify-content: flex-start; border: 0; padding: 0; background: none; text-align: left; cursor: pointer; color: var(--bone); transition: transform .3s ease; }
  .th { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; background: #1a1816; border-radius: 4px; box-shadow: 0 8px 24px rgba(0,0,0,.4); }
  .th img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pl { position: absolute; z-index: 2; inset: 0; margin: auto; width: 48px; height: 48px; border-radius: 50%; background: rgba(0,0,0,.45); border: 1px solid rgba(255,255,255,.7); display: grid; place-items: center; opacity: 0; transition: .25s; }
  .pl svg { width: 45%; fill: #fff; margin-left: 3px; }
  /* Avance al pasar el ratón: una sola capa que cambia de fotograma. */
  .th :global(img.fr) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .25s ease; }
  .th :global(img.fr.on) { opacity: 1; }
  .bar { position: absolute; z-index: 2; left: 0; bottom: 0; height: 3px; width: 0; background: var(--red); }
  .film-card:hover .bar { width: 100%; transition: width var(--len, 16s) linear; }
  .film-card:hover .pl, .film-card:focus-visible .pl { opacity: 1; background: var(--red); border-color: var(--red); }
  .ftl { display: block; margin-top: 10px; font: 500 18px/1.25 var(--display); color: rgba(255,255,255,.9); }
  .film-card:hover .ftl { color: #fff; }
  .ra { position: absolute; z-index: 3; top: 10px; bottom: 50px; width: calc(var(--gutter) + 10px); min-width: 44px; border: 0; background: rgba(11,10,9,.72); color: #fff; cursor: pointer; display: grid; place-items: center; opacity: 0; transition: opacity .2s, background .2s; }
  .ra[hidden] { display: none; }
  .ra svg { width: 30px; fill: none; stroke: currentColor; stroke-width: 2.4; }
  .ra.prev { left: 0; } .ra.next { right: 0; }
  .row:hover .ra, .ra:focus-visible { opacity: 1; }
  .ra:hover { background: rgba(191,18,29,.85); }
  @media (hover: hover) and (min-width: 821px) { .film-card:hover { transform: scale(1.05); z-index: 2; } }
  @media (hover: none) { .ra { display: none; } .pl { opacity: 1; } }
  @media (max-width: 820px) {
    .nf-hero { min-height: 0; display: block; }
    .bb-img { position: relative; height: auto; aspect-ratio: 16 / 9; display: none; }
    .bb-img.on { display: block; }
    .nf-hero { padding-top: calc(var(--page-top) - 40px); }
    .bb-shade { display: none; }
    .bb-in { padding-top: 18px; padding-bottom: 30px; }
    .bb-txt { margin-top: 18px; }
    .bb-txt h2 { font-size: 34px; }
    .flist { grid-auto-columns: 74vw; }
  }
  .yt { margin: 56px 0 0; text-align: center; }
  .vmodal { position: fixed; inset: 0; z-index: 210; display: grid; place-items: center; padding: 20px; background: rgba(8,7,6,.94); opacity: 0; transition: opacity .25s; }
  .vmodal.on { opacity: 1; }
  .vmodal[hidden] { display: none; }
  .vm-box { width: min(1200px, 100%, calc((100vh - 170px) * 16 / 9)); color: #fff; transform: translateY(12px) scale(.98); transition: transform .3s; }
  .vmodal.on .vm-box { transform: none; }
  .vm-top { display: flex; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: 12px; }
  .vm-top small { font: 500 10px var(--label); letter-spacing: .2em; text-transform: uppercase; color: #ff6b6b; }
  .vm-top h2 { margin: 4px 0 0; font-size: clamp(22px, 2.4vw, 34px); color: #fff; }
  .vm-close, .vm-nav button { background: none; border: 0; color: rgba(255,255,255,.8); font: 500 11px var(--label); letter-spacing: .2em; text-transform: uppercase; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; }
  .vm-close:hover, .vm-nav button:hover { color: #fff; }
  .vm-close kbd { border: 1px solid rgba(255,255,255,.3); padding: 2px 6px; font: inherit; }
  .vm-frame { aspect-ratio: 16 / 9; background: #000; box-shadow: 0 30px 80px rgba(0,0,0,.6); }
  .vm-frame :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .vm-nav { display: flex; justify-content: space-between; margin-top: 12px; }
  html.vm-lock { overflow: hidden; }
  @media (max-width: 600px) { .vm-close kbd { display: none; } .vmodal { padding: 12px; } }
</style>

<script>
  const yt = (id: string) => `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&playsinline=1&vq=hd1080`;
  const iframe = (id: string, title: string) => {
    const f = document.createElement('iframe');
    f.src = yt(id); f.title = title;
    f.allow = 'autoplay; fullscreen; encrypted-media; picture-in-picture';
    f.allowFullscreen = true;
    return f;
  };

  // Resto de películas: se abren en grande en una ventana, con anterior y siguiente.
  const modal = document.getElementById('vmodal')!;
  const mFrame = document.getElementById('vm-frame')!;
  // Solo las tarjetas de películas (el pie de página también tiene tarjetas .film-card de redes sociales).
  const cards = [...document.querySelectorAll<HTMLElement>('.fgroup .film-card[data-play]')];
  let cur = -1;
  // Anterior / siguiente: dentro de la misma fila.
  let rowCards: HTMLElement[] = [];
  const visible = () => rowCards;
  const open = (c: HTMLElement) => {
    rowCards = [...c.closest<HTMLElement>('.flist')!.querySelectorAll<HTMLElement>('.film-card')];
    cur = rowCards.indexOf(c);
    document.getElementById('vm-title')!.textContent = c.dataset.title!;
    document.getElementById('vm-group')!.textContent = c.dataset.group!;
    mFrame.replaceChildren(iframe(c.dataset.play!, c.dataset.title!));
    if (modal.hidden) { modal.hidden = false; document.documentElement.classList.add('vm-lock'); requestAnimationFrame(() => modal.classList.add('on')); }
  };
  const close = () => { modal.classList.remove('on'); document.documentElement.classList.remove('vm-lock'); mFrame.replaceChildren(); setTimeout(() => { modal.hidden = true; }, 250); };
  const step = (n: number) => { const v = visible(); if (v.length) open(v[(cur + n + v.length) % v.length]); };
  cards.forEach((c) => c.addEventListener('click', () => open(c)));
  document.getElementById('vm-close')!.addEventListener('click', close);
  document.getElementById('vm-prev')!.addEventListener('click', () => step(-1));
  document.getElementById('vm-next')!.addEventListener('click', () => step(1));
  modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
  document.addEventListener('keydown', (e) => {
    if (modal.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowRight') step(1);
    if (e.key === 'ArrowLeft') step(-1);
  });

  // Avance al pasar el ratón: fotogramas reales de la película (sin la intro), unos 2,5 s cada uno.
  const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
  const HOLD = 2500;
  document.querySelectorAll<HTMLElement>('[data-hover]').forEach((el) => {
    const id = el.dataset.hover!;
    const n = Number(el.dataset.frames || 0);
    // Sin fotogramas propios: las 3 miniaturas automáticas de YouTube (al 25, 50 y 75 % del vídeo, nunca la intro).
    const srcs = n ? Array.from({ length: n }, (_, k) => `${base}img/frames/${id}-${k + 1}.jpg`) : [1, 2, 3].map((k) => `https://i.ytimg.com/vi/${id}/sd${k}.jpg`);
    el.style.setProperty('--len', `${(srcs.length * HOLD) / 1000}s`);
    // Una sola capa encima de la miniatura: cambia de fotograma de golpe, sin fundidos ni zoom,
    // para que nunca se vean dos imágenes superpuestas.
    let frames: string[] = [], ov: HTMLImageElement | null = null, t: number | undefined, i = 0, over = false;
    const prep = () => {
      if (ov) return;
      ov = document.createElement('img');
      ov.className = 'fr'; ov.alt = ''; ov.decoding = 'async';
      el.insertBefore(ov, el.querySelector('.bar') ?? el.querySelector('.pl'));
      // Fotogramas de 640 px; si el vídeo no los tiene, los de 480 px. YouTube devuelve una imagen gris
      // de 120 px cuando no existe, así que se mira también el tamaño. Se quitan los que fallan.
      frames = srcs.map(() => '');
      srcs.forEach((src, k) => {
        const pre = new Image();
        const low = () => { if (/\/sd\d\.jpg$/.test(pre.src)) { pre.src = pre.src.replace(/\/sd(\d)\.jpg$/, '/hq$1.jpg'); return; } frames[k] = ''; };
        pre.onload = () => { if (!n && pre.naturalWidth < 200) low(); else frames[k] = pre.src; };
        pre.onerror = low;
        pre.src = src;
      });
    };
    const show = () => {
      if (!over || !ov) return;
      const ok = frames.filter(Boolean);
      if (!ok.length) { t = window.setTimeout(show, 150); return; }
      ov.src = ok[i % ok.length]; ov.classList.add('on'); i++;
      t = window.setTimeout(show, HOLD);
    };
    el.addEventListener('mouseenter', () => {
      prep(); over = true; i = 0; clearTimeout(t);
      t = window.setTimeout(show, 150);
    });
    el.addEventListener('mouseleave', () => { over = false; clearTimeout(t); ov?.classList.remove('on'); });
  });

  // Película destacada: cambia sola entre las recomendadas cada 8 s (se para con el ratón encima).
  const bbImgs = [...document.querySelectorAll<HTMLElement>('.bb-img')];
  const dots = [...document.querySelectorAll<HTMLElement>('.bb-dots button')];
  const rec = [...document.querySelectorAll<HTMLElement>('.fgroup[data-g="recomendadas"] .film-card')];
  let bi = 0, bt: number | undefined;
  const setBB = (k: number) => {
    bi = (k + rec.length) % rec.length;
    bbImgs.forEach((im, j) => im.classList.toggle('on', j === bi));
    dots.forEach((d, j) => d.classList.toggle('on', j === bi));
    document.getElementById('bb-title')!.textContent = rec[bi].dataset.title!;
    document.getElementById('bb-group')!.textContent = rec[bi].dataset.group!;
  };
  const auto = () => { clearInterval(bt); bt = window.setInterval(() => setBB(bi + 1), 8000); };
  dots.forEach((d, j) => d.addEventListener('click', () => { setBB(j); auto(); }));
  document.getElementById('bb-play')!.addEventListener('click', () => open(rec[bi]));
  const bb = document.getElementById('bb')!;
  bb.addEventListener('mouseenter', () => clearInterval(bt));
  bb.addEventListener('mouseleave', auto);
  auto();

  // Flechas de cada fila: avanzan casi una pantalla; se ocultan al llegar al principio o al final.
  document.querySelectorAll<HTMLElement>('.row').forEach((row) => {
    const list = row.querySelector<HTMLElement>('.flist')!;
    const prev = row.querySelector<HTMLElement>('.prev')!, next = row.querySelector<HTMLElement>('.next')!;
    const upd = () => { prev.hidden = list.scrollLeft < 8; next.hidden = list.scrollLeft + list.clientWidth >= list.scrollWidth - 8; };
    const go = (d: number) => list.scrollBy({ left: d * list.clientWidth * 0.85, behavior: 'smooth' });
    prev.addEventListener('click', () => go(-1)); next.addEventListener('click', () => go(1));
    list.addEventListener('scroll', upd, { passive: true }); window.addEventListener('resize', upd); upd();
  });
</script>
