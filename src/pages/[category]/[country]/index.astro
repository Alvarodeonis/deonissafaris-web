---
import Layout from '../../../layouts/Layout.astro';
import ProgramCard from '../../../components/ProgramCard.astro';
import { categories } from '../../../data/site.js';
import { countries } from '../../../data/programs.js';
import { u } from '../../../lib/url.js';

export function getStaticPaths() {
  return categories.flatMap((cat) =>
    countries(cat.slug).map((c) => ({ params: { category: cat.slug, country: c.slug }, props: { cat, c } })),
  );
}
const { cat, c } = Astro.props;
const arco = cat.slug === 'caza-con-arco';
---
<Layout title={arco ? `Caza con arco en ${c.name}` : `Caza en ${c.name}`} description={`${arco ? 'Caza con arco' : 'Caza'} en ${c.name} con de Onís Safaris: ${c.programs.map((p) => p.title).join(', ')}. Precios, temporadas y presupuesto a medida.`} image={c.programs[0].hero} crumbs={[[cat.title, cat.slug], [c.name, `${cat.slug}/${c.slug}`]]}>
  <section class="head">
    <div class="wrap">
      <div class="crumbs"><a href={u()}>Inicio</a><span>/</span><a href={u(cat.slug)}>{cat.title}</a><span>/</span><span>{c.name}</span></div>
      <h1>{cat.slug === 'caza-con-arco' ? `Arco en ${c.name}` : `Caza en ${c.name}`}</h1>
      <p class="count">{c.programs.length} {c.programs.length === 1 ? 'programa' : 'programas'} · los más actualizados primero</p>
    </div>
  </section>
  <section class="list">
    <div class="wrap">
      <div class="grid-3">{c.programs.map((p) => <ProgramCard p={p} />)}</div>
    </div>
  </section>
</Layout>

<style>
  .head { padding-block: var(--page-top) 0; }
  .head h1 { font-size: clamp(44px, 5vw, 76px); }
  @media (min-width: 961px) {
    .head { padding-top: 104px; }
    .head .crumbs, .head h1, .count { text-align: center; justify-content: center; }
    .head h1 { margin: 10px 0 0; }
  }
  .count { margin: 10px 0 0; font: 500 12px var(--label); letter-spacing: .22em; text-transform: uppercase; color: var(--stone); }
  .list { padding-top: 32px; }
  @media (max-width: 760px) { .head { padding-top: 120px; } }
</style>
