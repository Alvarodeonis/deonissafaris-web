---
import { programPaths } from '../../../lib/routes.js';
import { speciesOf, speciesUrl } from '../../../data/species.js';
import { filmGroups } from '../../../data/films.js';
import Layout from '../../../layouts/Layout.astro';
import Simulator from '../../../components/Simulator.astro';
import ProgramCard from '../../../components/ProgramCard.astro';
import TeamStrip from '../../../components/TeamStrip.astro';
import ProgramDetails from '../../../components/ProgramDetails.astro';
import LegalNote from '../../../components/LegalNote.astro';
import Lightbox from '../../../components/Lightbox.astro';
import ProgramMap from '../../../components/ProgramMap.astro';
import SeoText from '../../../components/SeoText.astro';
import { seoTexts } from '../../../data/seo-texts.js';
import { details } from '../../../data/details.js';
import { galleries } from '../../../data/galleries.js';
import { allCategories as categories } from '../../../data/site.js';
import { programs, programUrl, fromPrice, money, isCurrent, programYear } from '../../../data/programs.js';
import { u } from '../../../lib/url.js';
import { contact } from '../../../data/site.js';

export const getStaticPaths = programPaths;
const { p } = Astro.props;
const cat = categories.find((c) => c.slug === p.category);
// País con un solo programa: la página del país apunta aquí (canonical) y su guía se muestra en esta ficha.
const onlyOne = programs.filter((o) => o.category === p.category && o.country === p.country).length === 1;
const countrySeo = onlyOne ? seoTexts[`${p.category}/${p.country}`] : null;
const countryFaq = countrySeo?.faq?.length ? [{ '@type': 'FAQPage', mainEntity: countrySeo.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1') } })) }] : [];
const from = fromPrice(p);
const cur = isCurrent(p);
const oldYear = programYear(p);
const sim = cur && p.simulator;
const d = details[p.slug] ?? p.details;
const fslug = (x) => x.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z]+/g, '-');
const countryFilm = filmGroups.find((g) => g.slug === fslug(p.countryName))?.films[0]?.id;
const heroVideo = p.video || countryFilm;
const photos = [...new Set([p.hero, ...(galleries[p.slug] ?? p.gallery)])];
const related = [...programs.filter((o) => o !== p && o.country === p.country), ...programs.filter((o) => o !== p && o.country !== p.country && o.category === p.category)].slice(0, 3);
const wa = `https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(`Hola, me gustaría recibir un presupuesto del programa «${p.title}» en ${p.countryName}.`)}`;
const facts = [
  ['Temporada', p.season],
  ['Duración', p.duration],
  ['Zona', p.area],
  ['Alojamiento', p.lodging],
].filter(([, v]) => v);
const spTags = speciesOf(p);
const unit = cat.unit ?? 'cazador';
// Datos estructurados: el programa como viaje organizado, con su precio de partida.
const trip = {
  '@type': 'TouristTrip', name: `${p.title} · ${p.countryName}`, description: p.summary, image: photos.slice(0, 6).map((x) => new URL(x, Astro.site).href),
  touristType: p.category === 'caza-con-arco' ? 'Cazadores con arco' : p.category === 'pesca' ? 'Pescadores' : p.category === 'safaris-fotograficos' ? 'Viajeros' : 'Cazadores',
  provider: { '@id': new URL(u().replace(/\/?$/, '/'), Astro.site).href + '#org' },
  itinerary: { '@type': 'Place', name: p.area ? `${p.area}, ${p.countryName}` : p.countryName },
  ...(from && cur ? { offers: { '@type': 'Offer', price: from.amount, priceCurrency: ['USD', 'GBP'].includes(from.currency) ? from.currency : 'EUR', availability: 'https://schema.org/InStock', url: new URL(u(programUrl(p)).replace(/\/?$/, '/'), Astro.site).href } } : {}),
};
---
<Layout title={`${p.title} · ${p.countryName}`} description={p.summary} image={p.hero} transparentHeader crumbs={[[cat.title, p.category], [p.countryName, `${p.category}/${p.country}`], [p.title, programUrl(p)]]} schema={[trip, ...countryFaq]}>
  <div class="page-hero program-hero">
    <div class="ph">
      <button type="button" class="hero-media" data-lb="prog" data-src={photos[0]} aria-label="Ampliar foto">
        <img class="bg" src={p.hero} alt="" aria-hidden="true" />
        <img class="fg" fetchpriority="high" src={p.hero} alt={`${p.title} en ${p.countryName}`} />
      </button>
      <div class="wrap ph-info">
        <div class="crumbs">
          <a href={u()}>Inicio</a><span>/</span><a href={u(p.category)}>{cat.title}</a><span>/</span><a href={u(`${p.category}/${p.country}`)}>{p.countryName}</a>
        </div>
        {p.tag && <span class="tag" style="position:static;display:inline-block;margin-bottom:14px">{p.tag}</span>}
        <div class="eyebrow" style="margin-bottom:10px">{p.countryName}</div>
        <h1>{p.title}</h1>
        {!cur && <p class="old-note">Programa de temporadas anteriores{oldYear ? ` (tarifas ${oldYear})` : ''}. Los precios son orientativos: escríbenos y te confirmamos disponibilidad y tarifa actualizada.</p>}
        {from && <div class="from">Desde <b>{money(from.amount, from.currency)}</b> / {unit}</div>}
        <div class="hero-act">
        <div class="hero-btns">
          {sim ? <a class="btn" href="#simulador">Calcular presupuesto</a> : <a class="btn" href={wa} target="_blank" rel="noopener">Pedir presupuesto</a>}
          {d && <a class="btn outline" href="#programa">Ver precios</a>}
        </div>
        <div class="hero-media-btns">
          {heroVideo ? (
            <button type="button" class="hero-play" data-yt={heroVideo}>
              <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>Vídeos
            </button>
          ) : (
            <a class="hero-play" href={u('videos')}>
              <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>Vídeos
            </a>
          )}
          <button type="button" class="hero-play" data-lb="prog" data-src={photos[0]}>
            <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 5h16v14H4zM6 17h12l-4-5-3 4-2-2z" /></svg></span>Fotos ({photos.length})
          </button>
        </div>
        <div class="hero-map"><ProgramMap country={p.country} name={p.countryName} area={p.area} /></div>
        </div>
      </div>
    </div>
  </div>

  <section class="intro">
    <div class="wrap">
      <p class="summary">{p.summary}</p>
      <dl class="facts">
        {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      {spTags.length > 0 && (
        <div class="sp-tags"><span>Especies</span>{spTags.map((s) => <a href={u(speciesUrl(s))}>{s.name}</a>)}</div>
      )}
    </div>
  </section>

  {photos.length > 1 && (
    <div class="gal-wrap">
      <button type="button" class="gal-arrow prev" data-gal="-1" aria-label="Fotos anteriores">‹</button>
      <button type="button" class="gal-arrow next" data-gal="1" aria-label="Fotos siguientes">›</button>
    <div class="gallery" id="fotos">
      {photos.slice(1).map((g, i) => (
        <button type="button" data-lb="prog" data-src={g} aria-label={`Ampliar foto ${i + 2} de ${photos.length}`}>
          <img src={g} alt={`${p.title}, ${p.countryName}`} loading="lazy" />
        </button>
      ))}
    </div>
    </div>
  )}


  {d && !cur && <div class="wrap"><p class="old-note band">Precios orientativos de {oldYear || 'temporadas anteriores'}. <a href={wa} target="_blank" rel="noopener">Pídenos la tarifa actual por WhatsApp</a>.</p></div>}
  {d && <ProgramDetails d={d} title={p.title} />}

  {p.video && (
    <section class="video-sec dark" id="video">
      <div class="wrap">
        <div class="eyebrow">Vídeo</div>
        <h2>{cat.verb ?? 'Así se caza aquí'}</h2>
        <button type="button" class="video-facade" data-yt={p.video} aria-label={`Reproducir vídeo de ${p.title}`}>
          <img src={`https://i.ytimg.com/vi/${p.video}/maxresdefault.jpg`} alt="" loading="lazy" onerror="this.onerror=null;this.src=this.src.replace('maxresdefault','hqdefault')" />
          <span class="vplay" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>
        </button>
      </div>
    </section>
  )}

  {sim ? <Simulator p={p} /> : (
    <section class="ask" id="presupuesto">
      <div class="wrap"><div class="ask-box">
        <div>
          <div class="eyebrow">Presupuesto a medida</div>
          <h2>{d?.blocks.length ? 'Te preparamos el presupuesto' : 'Consúltanos este programa'}</h2>
          <p>{d?.blocks.length ? (cat.unit ? `Cuéntanos cuántos sois, las fechas y lo que os interesa, y te enviamos un presupuesto cerrado.` : 'Cuéntanos cuántos cazadores y acompañantes sois, las fechas y los trofeos que te interesan, y te enviamos un presupuesto cerrado.') : 'Las tarifas de este destino cambian cada temporada. Escríbenos y te enviamos los precios actualizados, las fechas disponibles y un presupuesto sin compromiso.'}</p>
        </div>
        <div class="ask-btns">
          <a class="btn" href={wa} target="_blank" rel="noopener">Pedir por WhatsApp</a>
          <a class="btn outline" href={`mailto:${contact.email}?subject=${encodeURIComponent(`Presupuesto: ${p.title} (${p.countryName})`)}`}>Pedir por email</a>
        </div>
      </div></div>
    </section>
  )}

  <LegalNote />

  {!d && p.includes && <section>
    <div class="wrap inc">
      <div>
        <h2>Incluye</h2>
        <ul class="yes">{p.includes.map((i) => <li>{i}</li>)}</ul>
      </div>
      <div>
        <h2>No incluye</h2>
        <ul class="no">{p.excludes.map((i) => <li>{i}</li>)}</ul>
      </div>
    </div>
  </section>}


  {countrySeo && <SeoText data={countrySeo} />}

  <section class="more">
    <div class="wrap">
      <div class="sec-head"><div><div class="eyebrow">También te puede interesar</div><h2>Otros programas</h2></div></div>
      <div class="grid-3">{related.map((o) => <ProgramCard p={o} />)}</div>
    </div>
  </section>

  <div class="vmodal" id="vmodal" hidden>
    <button type="button" class="vclose" id="vclose" aria-label="Cerrar vídeo">×</button>
    <div class="vframe" id="vframe"></div>
  </div>

  <TeamStrip />
  <Lightbox />
</Layout>

<script>
  const modal = document.getElementById('vmodal')!;
  const frame = document.getElementById('vframe')!;
  const close = () => { modal.hidden = true; frame.innerHTML = ''; };
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((b) => b.addEventListener('click', () => {
    frame.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${b.dataset.yt}?autoplay=1&rel=0&vq=hd1080" allow="autoplay; fullscreen; encrypted-media" allowfullscreen title="Vídeo"></iframe>`;
    modal.hidden = false;
  }));
  document.getElementById('vclose')!.addEventListener('click', close);
  modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

  // Carrusel: avanza solo y se detiene al pasar el ratón o tocarlo.
  const gal = document.querySelector<HTMLElement>('.gallery');
  if (gal && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let paused = false; let pos = 0;
    const stop = () => { paused = true; }; const go = () => { paused = false; pos = gal.scrollLeft; };
    // Se detiene al pasar el ratón por las fotos o por las flechas, para que las flechas no peleen con el avance automático.
    const wrap = gal.closest<HTMLElement>('.gal-wrap') ?? gal;
    wrap.addEventListener('mouseenter', stop); wrap.addEventListener('mouseleave', go);
    gal.addEventListener('scroll', () => { if (paused) pos = gal.scrollLeft; }, { passive: true });
    gal.addEventListener('touchstart', stop, { passive: true }); gal.addEventListener('touchend', () => setTimeout(go, 2500));
    const step = () => {
      if (!paused) {
        pos += 0.5;
        if (pos >= gal.scrollWidth - gal.clientWidth - 1) pos = 0;
        gal.scrollLeft = pos;
      }
      requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }
  // Arrastrar con el ratón para pasar las fotos.
  if (gal) {
    let down = false, moved = false, sx = 0, sl = 0;
    gal.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      down = true; moved = false; sx = e.clientX; sl = gal.scrollLeft; gal.classList.add('grab');
    });
    window.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - sx;
      if (Math.abs(dx) > 5) moved = true;
      gal.scrollLeft = sl - dx;
    });
    window.addEventListener('pointerup', () => { if (!down) return; down = false; gal.classList.remove('grab'); });
    gal.addEventListener('click', (e) => { if (moved) { e.stopPropagation(); e.preventDefault(); moved = false; } }, true);
    gal.addEventListener('dragstart', (e) => e.preventDefault());
    document.querySelectorAll<HTMLElement>('[data-gal]').forEach((b) => b.addEventListener('click', () => {
      // Salta de foto en foto: busca la siguiente (o anterior) que no se ve entera.
      const dir = Number(b.dataset.gal);
      const g0 = gal.getBoundingClientRect().left - gal.scrollLeft;
      const items = ([...gal.children] as HTMLElement[]).map((it) => { const r = it.getBoundingClientRect(); return { l: r.left - g0, r: r.right - g0 }; });
      const left = gal.scrollLeft, right = left + gal.clientWidth;
      const target = dir > 0 ? items.find((it) => it.r > right + 2) : [...items].reverse().find((it) => it.l < left - 2);
      const to = target ? (dir > 0 ? target.l : target.r - gal.clientWidth) : (dir > 0 ? 0 : gal.scrollWidth);
      gal.scrollTo({ left: to, behavior: 'smooth' });
    }));
  }
</script>

<style>
  .sp-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 18px; }
  .sp-tags span { margin-right: 6px; font: 500 11px var(--label); letter-spacing: .2em; text-transform: uppercase; color: var(--stone); }
  .sp-tags a { padding: 7px 14px; border: 1px solid var(--line); font: 500 11px var(--label); letter-spacing: .16em; text-transform: uppercase; text-decoration: none; transition: .2s; }
  .sp-tags a:hover { background: var(--red); border-color: var(--red); color: #fff; }
  .ask-box { display: grid; grid-template-columns: minmax(0, 1.4fr) auto; gap: 40px; align-items: center; border: 1px solid var(--line); border-left: 2px solid var(--red); background: var(--char); padding: clamp(24px, 3vw, 44px); }
  .ask h2 { font-size: clamp(30px, 3vw, 42px); margin: 10px 0 12px; }
  .ask p { margin: 0; color: var(--stone); max-width: 60ch; }
  .ask-btns { display: flex; flex-direction: column; gap: 12px; }
  @media (max-width: 760px) { .ask-box { grid-template-columns: 1fr; } }
  .hero-media { display: block; width: 100%; padding: 0; border: 0; cursor: zoom-in; }
  .from { margin-top: 16px; }
  .hero-btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
  .hero-media-btns { display: flex; flex-wrap: wrap; gap: 28px; margin-top: 18px; }
  .hero-map { margin-top: 18px; max-width: 460px; }
  @media (min-width: 1100px) and (max-height: 840px) { .hero-map { max-width: 340px; margin-top: 14px; } }
  @media (min-width: 961px) {
    .ph { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); align-items: center; gap: 0; padding-block: 8px; }
    .ph .hero-media { order: 2; height: auto; min-height: 0; overflow: visible; background: none; }
    .ph .hero-media .fg { position: static; display: block; width: 100%; height: auto; max-height: calc(100vh - 130px); object-fit: contain; object-position: center right; }
    .ph .ph-info { order: 1; padding: 40px 48px 16px max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter))); }
    .ph h1 { font-size: clamp(40px, 4vw, 66px); }
  }
  .from { font: 500 13px var(--label); letter-spacing: .1em; text-transform: uppercase; }
  .from b { font: 600 34px var(--display); letter-spacing: 0; color: var(--bone); margin: 0 6px; text-transform: none; }
  .intro .wrap { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 56px; }
  .summary { font: 500 clamp(24px, 2.2vw, 32px)/1.35 var(--display); margin: 0; }
  .facts { margin: 0; display: grid; gap: 0; align-content: start; }
  .facts div { display: grid; grid-template-columns: 130px minmax(0, 1fr); gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .facts dt { font: 500 10px var(--label); letter-spacing: .16em; text-transform: uppercase; color: var(--red-hi); padding-top: 3px; }
  .facts dd { margin: 0; }
  @media (max-width: 860px) { .intro .wrap { grid-template-columns: 1fr; gap: 32px; } }
  .gallery { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; }
  .gallery::-webkit-scrollbar { display: none; }
  .gal-wrap { position: relative; }
  .gal-arrow { position: absolute; top: 50%; z-index: 2; width: 46px; height: 46px; margin-top: -23px; border: 1px solid rgba(255,255,255,.6); border-radius: 50%; background: rgba(0,0,0,.45); color: #fff; font: 300 30px/1 var(--display); cursor: pointer; opacity: 0; transition: opacity .25s, background .2s; }
  .gal-arrow.prev { left: 14px; } .gal-arrow.next { right: 14px; }
  .gal-wrap:hover .gal-arrow { opacity: 1; }
  .gal-arrow:hover { background: var(--red); border-color: var(--red); }
  @media (hover: none) { .gal-arrow { display: none; } }
  .gallery { cursor: grab; user-select: none; }
  .gallery.grab { cursor: grabbing; }
  .gallery.grab button { cursor: grabbing; }
  .gallery button { flex: none; padding: 0; border: 0; background: var(--char); cursor: zoom-in; }
  .gallery button:hover img { opacity: .85; }
  .gallery img { display: block; transition: opacity .3s; flex: none; height: clamp(140px, 16vw, 220px); width: auto; max-width: none; background: var(--char); }
  .inc { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; }
  .inc h2 { font-size: 36px; margin-bottom: 18px; }
  .inc ul { list-style: none; margin: 0; padding: 0; }
  .inc li { padding: 11px 0 11px 30px; border-bottom: 1px solid var(--line); position: relative; }
  .yes li::before { content: '✓'; position: absolute; left: 0; color: #6fbf73; font-weight: 700; }
  .no li::before { content: '×'; position: absolute; left: 2px; color: var(--red-hi); font-weight: 700; font-size: 20px; line-height: 1.3; }
  @media (max-width: 760px) { .inc { grid-template-columns: 1fr; } }
  .video-sec { background: var(--char); }
  .video-sec h2 { font-size: clamp(34px, 3.8vw, 54px); margin: 12px 0 28px; }
  .video-facade { position: relative; display: block; width: 100%; aspect-ratio: 16 / 9; max-width: 100%; padding: 0; border: 0; cursor: pointer; overflow: hidden; background: var(--black); }
  .video-facade img { width: 100%; height: 100%; object-fit: cover; filter: brightness(.7); transition: transform .8s, filter .4s; }
  .video-facade:hover img { transform: scale(1.03); filter: brightness(.85); }
  .vplay { position: absolute; inset: 0; margin: auto; width: 96px; height: 96px; border-radius: 50%; border: 1px solid rgba(255,255,255,.8); background: rgba(0,0,0,.3); display: grid; place-items: center; transition: background .3s, border-color .3s, transform .3s; }
  .video-facade:hover .vplay { background: var(--red); border-color: var(--red); transform: scale(1.06); }
  .vplay svg { width: 40%; fill: #fff; margin-left: 5px; }
  .hero-play { display: inline-flex; align-items: center; gap: 12px; background: none; border: 0; color: var(--bone); cursor: pointer; font: 500 12px var(--label); letter-spacing: .24em; text-transform: uppercase; padding: 0; text-decoration: none; }
  .hero-play span { width: 46px; height: 46px; border-radius: 50%; border: 1px solid var(--stone); display: grid; place-items: center; transition: background .3s, border-color .3s; }
  .hero-play:hover span { background: var(--red); border-color: var(--red); color: #fff; }
  .hero-play svg { width: 40%; fill: currentColor; margin-left: 3px; }
  .vmodal { position: fixed; inset: 0; z-index: 100; background: rgba(0,0,0,.94); display: grid; place-items: center; padding: 20px; }
  .vmodal[hidden] { display: none; }
  .vframe { width: min(1280px, 100%); aspect-ratio: 16 / 9; }
  .vframe :global(iframe) { width: 100%; height: 100%; border: 0; }
  .vclose { z-index: 2; position: absolute; top: 14px; right: 20px; background: none; border: 0; color: #fff; font-size: 44px; cursor: pointer; line-height: 1; }
</style>
<style>
  .old-note { max-width: 560px; margin: 0 0 18px; padding: 12px 16px; border-left: 2px solid var(--red, #BF121D); background: rgba(191,18,29,.08); font-size: 14px; line-height: 1.5; color: var(--bone); }
  .old-note.band { max-width: none; margin: 28px 0 0; color: var(--bone); }
  .old-note a { color: var(--red, #BF121D); text-decoration: underline; }
  /* Móvil: llegar antes a los precios. */
  @media (max-width: 960px) {
    .ph .ph-info { padding-block: 18px 4px; }
    .ph .crumbs { margin-bottom: 10px; }
    .ph h1 { font-size: clamp(34px, 9vw, 48px); margin: 0 0 2px; }
    .ph .eyebrow { margin-bottom: 4px !important; }
    .from { margin-top: 8px; }
    .hero-btns { flex-wrap: nowrap; gap: 8px; margin-top: 14px; }
    .hero-btns .btn { flex: 1 1 0; justify-content: center; text-align: center; padding: 13px 6px; letter-spacing: .08em; font-size: 11px; white-space: nowrap; line-height: 1.3; }
    .hero-media-btns { margin-top: 12px; gap: 20px; }
    .hero-map { margin-top: 12px; }
    .intro { padding-block: 16px 12px; }
    .intro .wrap { gap: 14px !important; }
    .summary { font-size: 21px; }
    .facts div { padding: 6px 0; grid-template-columns: 110px minmax(0, 1fr); }
    .facts dd { line-height: 1.35; }
    .hero-map { max-width: none; }
    .sp-tags { margin-top: 4px; }
  }
  @media (max-width: 400px) { .hero-btns .btn { white-space: normal; } }
</style>
