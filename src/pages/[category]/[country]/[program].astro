---
import Layout from '../../../layouts/Layout.astro';
import Simulator from '../../../components/Simulator.astro';
import ProgramCard from '../../../components/ProgramCard.astro';
import ProgramDetails from '../../../components/ProgramDetails.astro';
import LegalNote from '../../../components/LegalNote.astro';
import { details } from '../../../data/details.js';
import { categories } from '../../../data/site.js';
import { programs, fromPrice, money } from '../../../data/programs.js';
import { u } from '../../../lib/url.js';

export function getStaticPaths() {
  return programs.map((p) => ({
    params: { category: p.category, country: p.country, program: p.slug },
    props: { p },
  }));
}
const { p } = Astro.props;
const cat = categories.find((c) => c.slug === p.category);
const from = fromPrice(p);
const d = details[p.slug];
const related = programs.filter((o) => o !== p && (o.category === p.category || o.featured)).slice(0, 3);
const facts = [
  ['Temporada', p.season],
  ['Duración', p.duration],
  ['Zona', p.area],
  ['Alojamiento', p.lodging],
];
---
<Layout title={`${p.title} · ${p.countryName}`} description={p.summary} image={p.hero} transparentHeader>
  <div class="page-hero program-hero">
    <div class="hero-media">
      <img class="bg" src={p.hero} alt="" aria-hidden="true" />
      <img class="fg" src={p.hero} alt={`${p.title} en ${p.countryName}`} />
    </div>
    <div class="wrap">
      <div class="crumbs">
        <a href={u()}>Inicio</a><span>/</span><a href={u(p.category)}>{cat.title}</a><span>/</span><a href={u(`${p.category}/${p.country}`)}>{p.countryName}</a>
      </div>
      {p.tag && <span class="tag" style="position:static;display:inline-block;margin-bottom:14px">{p.tag}</span>}
      <h1>{p.title}</h1>
      <div class="hero-row">
        {from && <div class="from">Desde <b>{money(from.amount, from.currency)}</b> / cazador</div>}
        <a class="btn" href="#simulador">Calcular presupuesto</a>
        {d && <a class="btn outline" href="#programa">Ver programa completo</a>}
        {p.video && (
          <button type="button" class="hero-play" data-yt={p.video}>
            <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>Ver vídeo
          </button>
        )}
      </div>
    </div>
  </div>

  <section class="intro">
    <div class="wrap">
      <p class="summary">{p.summary}</p>
      <dl class="facts">
        {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
  </section>

  {p.gallery.length > 0 && (
    <div class="gallery">
      {p.gallery.map((g) => <img src={g} alt={`${p.title}, ${p.countryName}`} loading="lazy" />)}
    </div>
  )}

  {p.video && (
    <section class="video-sec" id="video">
      <div class="wrap">
        <div class="eyebrow">Vídeo</div>
        <h2>Así se caza aquí</h2>
        <button type="button" class="video-facade" data-yt={p.video} aria-label={`Reproducir vídeo de ${p.title}`}>
          <img src={`https://i.ytimg.com/vi/${p.video}/maxresdefault.jpg`} alt="" loading="lazy" onerror="this.onerror=null;this.src=this.src.replace('maxresdefault','hqdefault')" />
          <span class="vplay" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>
        </button>
      </div>
    </section>
  )}

  {d && <ProgramDetails d={d} title={p.title} />}

  {p.simulator && <Simulator p={p} />}

  {!d && <section>
    <div class="wrap inc">
      <div>
        <h2>Incluye</h2>
        <ul class="yes">{p.includes.map((i) => <li>{i}</li>)}</ul>
      </div>
      <div>
        <h2>No incluye</h2>
        <ul class="no">{p.excludes.map((i) => <li>{i}</li>)}</ul>
      </div>
    </div>
  </section>}


  <section class="more">
    <div class="wrap">
      <div class="sec-head"><div><div class="eyebrow">También te puede interesar</div><h2>Otros programas</h2></div></div>
      <div class="grid-3">{related.map((o) => <ProgramCard p={o} />)}</div>
    </div>
  </section>

  <LegalNote />

  <div class="vmodal" id="vmodal" hidden>
    <button type="button" class="vclose" id="vclose" aria-label="Cerrar vídeo">×</button>
    <div class="vframe" id="vframe"></div>
  </div>
</Layout>

<script>
  const modal = document.getElementById('vmodal')!;
  const frame = document.getElementById('vframe')!;
  const close = () => { modal.hidden = true; frame.innerHTML = ''; };
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((b) => b.addEventListener('click', () => {
    frame.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${b.dataset.yt}?autoplay=1&rel=0&vq=hd1080" allow="autoplay; fullscreen; encrypted-media" allowfullscreen title="Vídeo"></iframe>`;
    modal.hidden = false;
  }));
  document.getElementById('vclose')!.addEventListener('click', close);
  modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
</script>

<style>
  .hero-row { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 26px; }
  .from { font: 500 13px var(--label); letter-spacing: .1em; text-transform: uppercase; }
  .from b { font: 600 34px var(--display); letter-spacing: 0; color: #fff; margin: 0 6px; text-transform: none; }
  .intro .wrap { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 56px; }
  .summary { font: 500 clamp(24px, 2.2vw, 32px)/1.35 var(--display); margin: 0; }
  .facts { margin: 0; display: grid; gap: 0; }
  .facts div { display: grid; grid-template-columns: 130px minmax(0, 1fr); gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .facts dt { font: 500 10px var(--label); letter-spacing: .16em; text-transform: uppercase; color: var(--red-hi); padding-top: 3px; }
  .facts dd { margin: 0; }
  @media (max-width: 860px) { .intro .wrap { grid-template-columns: 1fr; gap: 32px; } }
  .gallery { display: flex; gap: 4px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: thin; }
  .gallery img { flex: none; height: clamp(240px, 34vw, 420px); width: auto; max-width: none; scroll-snap-align: start; background: var(--char); }
  .inc { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; }
  .inc h2 { font-size: 36px; margin-bottom: 18px; }
  .inc ul { list-style: none; margin: 0; padding: 0; }
  .inc li { padding: 11px 0 11px 30px; border-bottom: 1px solid var(--line); position: relative; }
  .yes li::before { content: '✓'; position: absolute; left: 0; color: #6fbf73; font-weight: 700; }
  .no li::before { content: '×'; position: absolute; left: 2px; color: var(--red-hi); font-weight: 700; font-size: 20px; line-height: 1.3; }
  @media (max-width: 760px) { .inc { grid-template-columns: 1fr; } }
  .video-sec { background: var(--char); }
  .video-sec h2 { font-size: clamp(34px, 3.8vw, 54px); margin: 12px 0 28px; }
  .video-facade { position: relative; display: block; width: 100%; aspect-ratio: 16 / 9; max-width: 100%; padding: 0; border: 0; cursor: pointer; overflow: hidden; background: var(--black); }
  .video-facade img { width: 100%; height: 100%; object-fit: cover; filter: brightness(.7); transition: transform .8s, filter .4s; }
  .video-facade:hover img { transform: scale(1.03); filter: brightness(.85); }
  .vplay { position: absolute; inset: 0; margin: auto; width: 96px; height: 96px; border-radius: 50%; border: 1px solid rgba(255,255,255,.8); background: rgba(0,0,0,.3); display: grid; place-items: center; transition: background .3s, border-color .3s, transform .3s; }
  .video-facade:hover .vplay { background: var(--red); border-color: var(--red); transform: scale(1.06); }
  .vplay svg { width: 40%; fill: #fff; margin-left: 5px; }
  .hero-play { display: inline-flex; align-items: center; gap: 12px; background: none; border: 0; color: #fff; cursor: pointer; font: 500 12px var(--label); letter-spacing: .24em; text-transform: uppercase; padding: 0; }
  .hero-play span { width: 46px; height: 46px; border-radius: 50%; border: 1px solid rgba(255,255,255,.7); display: grid; place-items: center; transition: background .3s, border-color .3s; }
  .hero-play:hover span { background: var(--red); border-color: var(--red); }
  .hero-play svg { width: 40%; fill: #fff; margin-left: 3px; }
  .vmodal { position: fixed; inset: 0; z-index: 100; background: rgba(0,0,0,.94); display: grid; place-items: center; padding: 20px; }
  .vmodal[hidden] { display: none; }
  .vframe { width: min(1280px, 100%); aspect-ratio: 16 / 9; }
  .vframe :global(iframe) { width: 100%; height: 100%; border: 0; }
  .vclose { position: absolute; top: 14px; right: 20px; background: none; border: 0; color: #fff; font-size: 44px; cursor: pointer; line-height: 1; }
</style>
