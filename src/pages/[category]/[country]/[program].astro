---
import { programPaths } from '../../../lib/routes.js';
import { speciesOf, speciesUrl } from '../../../data/species.js';
import { filmGroups, allFilms } from '../../../data/films.js';
import Layout from '../../../layouts/Layout.astro';
import Simulator from '../../../components/Simulator.astro';
import ProgramCard from '../../../components/ProgramCard.astro';
import TeamStrip from '../../../components/TeamStrip.astro';
import ProgramDetails from '../../../components/ProgramDetails.astro';
import LegalNote from '../../../components/LegalNote.astro';
import Lightbox from '../../../components/Lightbox.astro';
import { lodging } from '../../../data/lodging.js';
import ProgramMap from '../../../components/ProgramMap.astro';
import SeoText from '../../../components/SeoText.astro';
import { seoTexts } from '../../../data/seo-texts.js';
import { details } from '../../../data/details.js';
import { galleries } from '../../../data/galleries.js';
import { allCategories as categories } from '../../../data/site.js';
import { programs, programUrl, fromPrice, money, isCurrent, programYear } from '../../../data/programs.js';
import { u } from '../../../lib/url.js';
import { contact } from '../../../data/site.js';
import { needsOwnPdf, pdfName } from '../../../lib/own-pdf.js';

export const getStaticPaths = programPaths;
const { p } = Astro.props;
const cat = categories.find((c) => c.slug === p.category);
// País con un solo programa: la página del país apunta aquí (canonical) y su guía se muestra en esta ficha.
const onlyOne = programs.filter((o) => o.category === p.category && o.country === p.country).length === 1;
const countrySeo = onlyOne ? seoTexts[`${p.category}/${p.country}`] : null;
const countryFaq = countrySeo?.faq?.length ? [{ '@type': 'FAQPage', mainEntity: countrySeo.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1') } })) }] : [];
const from = fromPrice(p);
const cur = isCurrent(p);
const imgAlt = p.title.includes(p.countryName) ? p.title : `${p.title} · ${p.countryName}`;
const oldYear = programYear(p);
const sim = cur && p.simulator;
const d0 = details[p.slug] ?? p.details;
// PDF de la web antigua que no se pudo copiar: se usa el PDF generado desde esta misma página.
const d = d0 && needsOwnPdf(d0) ? { ...d0, pdf: `${u(programUrl(p))}/${pdfName(p)}` } : d0;
const fslug = (x) => x.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z]+/g, '-');
// Vídeos del programa: el suyo propio, los del país y, en arco, los de arco de ese país.
// Primero los que comparten palabras con el título del programa (especie, zona).
const words = (x) => fslug(x).split('-').filter((w) => w.length > 3);
const pWords = new Set(words(`${p.title} ${p.area ?? ''}`).filter((w) => !words(p.countryName).includes(w)));
const countryFilms = filmGroups.find((g) => g.slug === fslug(p.countryName))?.films ?? [];
const bowFilms = p.category === 'caza-con-arco' ? (filmGroups.find((g) => g.slug === 'caza-con-arco')?.films ?? []).filter((f) => words(f.title).some((w) => words(p.countryName).includes(w))) : [];
const score = (f) => (f.id === p.video ? 100 : 0) + (bowFilms.includes(f) ? 10 : 0) + words(f.title).filter((w) => pWords.has(w)).length;
const pool = [...(p.video ? [{ id: p.video, title: allFilms.find((f) => f.id === p.video)?.title ?? p.title }] : []), ...bowFilms, ...countryFilms];
const videos = pool.filter((f, i) => pool.findIndex((o) => o.id === f.id) === i)
  .map((f, i) => ({ ...f, i, s: score(f) })).sort((a, b) => b.s - a.s || a.i - b.i).slice(0, 9);
const photos = [...new Set([p.hero, ...(galleries[p.slug] ?? p.gallery)])];
const lodge = (lodging[p.slug] ?? []).map((f) => u(f));
const related = [...programs.filter((o) => o !== p && o.country === p.country), ...programs.filter((o) => o !== p && o.country !== p.country && o.category === p.category)].slice(0, 3);
const wa = `https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(`Hola, me gustaría recibir un presupuesto del programa «${p.title}» en ${p.countryName}.`)}`;
const facts = [
  ['Temporada', p.season],
  ['Duración', p.duration],
  ['Zona', p.area],
  ['Alojamiento', p.lodging],
].filter(([, v]) => v);
const spTags = speciesOf(p);
const unit = cat.unit ?? 'cazador';
// Datos estructurados: el programa como viaje organizado, con su precio de partida.
const trip = {
  '@type': 'TouristTrip', name: `${p.title} · ${p.countryName}`, description: p.summary, image: photos.slice(0, 6).map((x) => new URL(x, Astro.site).href),
  touristType: p.category === 'caza-con-arco' ? 'Cazadores con arco' : p.category === 'pesca' ? 'Pescadores' : p.category === 'safaris-fotograficos' ? 'Viajeros' : 'Cazadores',
  provider: { '@id': new URL(u().replace(/\/?$/, '/'), Astro.site).href + '#org' },
  itinerary: { '@type': 'Place', name: p.area ? `${p.area}, ${p.countryName}` : p.countryName },
  ...(from && cur ? { offers: { '@type': 'Offer', price: from.amount, priceCurrency: ['USD', 'GBP'].includes(from.currency) ? from.currency : 'EUR', availability: 'https://schema.org/InStock', url: new URL(u(programUrl(p)).replace(/\/?$/, '/'), Astro.site).href } } : {}),
};
---
<Layout title={`${p.title} · Caza en ${p.countryName}`} description={p.summary} image={p.hero} transparentHeader crumbs={[[cat.title, p.category], [p.countryName, `${p.category}/${p.country}`], [p.title, programUrl(p)]]} schema={[trip, ...countryFaq]}>
  <div class="page-hero program-hero">
    <div class="ph">
      <div class="hero-box">
      <button type="button" class="hero-media" data-lb="prog" data-src={photos[0]} aria-label="Ampliar foto">
        <img class="bg" src={p.hero} alt="" aria-hidden="true" />
        <img class="fg" fetchpriority="high" src={p.hero} alt={imgAlt} />
      </button>
      {photos.length > 1 && <>
        <button type="button" class="gal-arrow hero-arrow prev" data-hero="-1" aria-label="Foto anterior">‹</button>
        <button type="button" class="gal-arrow hero-arrow next" data-hero="1" aria-label="Foto siguiente">›</button>
      </>}
      </div>
      <div class="wrap ph-info">
        <div class="crumbs">
          <a href={u()}>Inicio</a><span>/</span><a href={u(p.category)}>{cat.title}</a><span>/</span><a href={u(`${p.category}/${p.country}`)}>{p.countryName}</a>
        </div>
        {p.tag && <span class="tag" style="position:static;display:inline-block;margin-bottom:14px">{p.tag}</span>}
        <div class="eyebrow" style="margin-bottom:10px">{p.countryName}</div>
        <h1>{p.title}</h1>
        {!cur && <p class="old-note">Programa de temporadas anteriores{oldYear ? ` (tarifas ${oldYear})` : ''}. Los precios son orientativos: escríbanos y le confirmamos disponibilidad y tarifa actualizada.</p>}
        {from && <div class="from">Desde <b>{money(from.amount, from.currency)}</b> / {unit}</div>}
        <div class="hero-act">
        <div class="hero-btns">
          {sim ? <a class="btn" href="#simulador">Calcular presupuesto</a> : <a class="btn" href={wa} target="_blank" rel="noopener">Pedir presupuesto</a>}
          {d && <a class="btn outline" href="#programa">Ver precios</a>}
        </div>
        <div class="hero-media-btns">
          <a class="hero-play" href={videos.length ? '#videos' : u('videos')}>
            <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>Vídeos{videos.length > 1 && <i class="cnt">&nbsp;({videos.length})</i>}
          </a>
          <a class="hero-play" href={photos.length > 1 ? '#fotos' : '#'} data-lb={photos.length > 1 ? undefined : 'prog'} data-src={photos.length > 1 ? undefined : photos[0]}>
            <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 5h16v14H4zM6 17h12l-4-5-3 4-2-2z" /></svg></span>Fotos ({photos.length})
          </a>
        </div>
        <div class="hero-map"><ProgramMap country={p.country} name={p.countryName} area={p.area} /></div>
        </div>
      </div>
    </div>
  </div>

  <section class="intro">
    <div class="wrap">
      <p class="summary">{p.summary}</p>
      <dl class="facts">
        {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      {spTags.length > 0 && (
        <div class="sp-tags"><span>Especies</span>{spTags.map((s) => <a href={u(speciesUrl(s))}>{s.name}</a>)}</div>
      )}
    </div>
  </section>

  {photos.length > 1 && (
    <section class="photos-sec" id="fotos" aria-labelledby="fotos-h">
      <div class="wrap"><h2 id="fotos-h" class="lodge-h">Fotos</h2></div>
      <div class="gal-wrap">
        <button type="button" class="gal-arrow prev" data-gal="-1" aria-label="Fotos anteriores">‹</button>
        <button type="button" class="gal-arrow next" data-gal="1" aria-label="Fotos siguientes">›</button>
        <div class="gallery">
          {photos.slice(1).map((g, i) => (
            <button type="button" data-lb="prog" data-src={g} aria-label={`Ampliar foto ${i + 2} de ${photos.length}`}>
              <img src={g} alt={imgAlt} loading="lazy" />
            </button>
          ))}
        </div>
      </div>
    </section>
  )}

  {lodge.length > 0 && (
    <section class="lodge" id="alojamiento" aria-labelledby="lodge-h">
      <div class="wrap"><h2 id="lodge-h" class="lodge-h">Alojamiento</h2></div>
      <div class="gal-wrap">
        <button type="button" class="gal-arrow prev" data-gal="-1" aria-label="Fotos anteriores">‹</button>
        <button type="button" class="gal-arrow next" data-gal="1" aria-label="Fotos siguientes">›</button>
        <div class="gallery">
          {lodge.map((g) => (
            <button type="button" data-lb="aloj" data-src={g} aria-label="Ampliar foto">
              <img src={g} alt="Alojamiento" loading="lazy" width="563" height="1000" />
            </button>
          ))}
        </div>
      </div>
    </section>
  )}


  {d && !cur && <div class="wrap"><p class="old-note band">Precios orientativos de {oldYear || 'temporadas anteriores'}. <a href={wa} target="_blank" rel="noopener">Pídanos la tarifa actual por WhatsApp</a>.</p></div>}
  {d && <ProgramDetails d={d} title={p.title} />}

  {videos.length > 0 && (
    <section class="video-sec dark" id="videos">
      <div class="wrap">
        <div class="eyebrow">Vídeos</div>
        <h2>{cat.verb ?? 'Así se caza aquí'}</h2>
        <div class={`vgrid n${Math.min(videos.length, 3)}`}>
          {videos.map((f, i) => (
            <figure class="vcard">
              <button type="button" class="video-facade" data-yt={f.id} aria-label={`Vídeo · ${f.title}`}>
                <img src={`https://i.ytimg.com/vi/${f.id}/${videos.length === 1 ? 'maxresdefault' : 'mqdefault'}.jpg`} alt="" loading="lazy" onerror="this.onerror=null;this.src=this.src.replace('maxresdefault','hqdefault')" />
                <span class="vplay" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>
              </button>
              {videos.length > 1 && <figcaption>{f.title}</figcaption>}
            </figure>
          ))}
        </div>
        {videos.length > 1 && <p class="vall"><a href={u('videos')}>Ver todos los vídeos</a></p>}
      </div>
    </section>
  )}

  {sim ? <Simulator p={p} /> : (
    <section class="ask" id="presupuesto">
      <div class="wrap"><div class="ask-box">
        <div>
          <div class="eyebrow">Presupuesto a medida</div>
          <h2>{d?.blocks.length ? 'Le preparamos el presupuesto' : 'Consúltenos este programa'}</h2>
          <p>{d?.blocks.length ? (cat.unit ? `Díganos cuántos son, las fechas y lo que les interesa, y les enviamos un presupuesto cerrado.` : 'Díganos cuántos cazadores y acompañantes son, las fechas y los trofeos que le interesan, y le enviamos un presupuesto cerrado.') : 'Las tarifas de este destino cambian cada temporada. Escríbanos y le enviamos los precios actualizados, las fechas disponibles y un presupuesto sin compromiso.'}</p>
        </div>
        <div class="ask-btns">
          <a class="btn" href={wa} target="_blank" rel="noopener">Pedir por WhatsApp</a>
          <a class="btn outline" href={`mailto:${contact.email}?subject=${encodeURIComponent(`Presupuesto: ${p.title} (${p.countryName})`)}`}>Pedir por email</a>
        </div>
      </div></div>
    </section>
  )}

  <LegalNote />

  {!d && p.includes && <section>
    <div class="wrap inc">
      <div>
        <h2>Incluye</h2>
        <ul class="yes">{p.includes.map((i) => <li>{i}</li>)}</ul>
      </div>
      <div>
        <h2>No incluye</h2>
        <ul class="no">{p.excludes.map((i) => <li>{i}</li>)}</ul>
      </div>
    </div>
  </section>}


  {countrySeo && <SeoText data={countrySeo} />}

  <section class="more">
    <div class="wrap">
      <div class="sec-head"><div><div class="eyebrow">También le puede interesar</div><h2>Otros programas</h2></div></div>
      <div class="grid-3">{related.map((o) => <ProgramCard p={o} />)}</div>
    </div>
  </section>

  <div class="vmodal" id="vmodal" hidden>
    <button type="button" class="vclose" id="vclose" aria-label="Cerrar vídeo">×</button>
    <div class="vframe" id="vframe"></div>
  </div>

  <TeamStrip />
  <Lightbox />
</Layout>

<script>
  // En ordenador, el mapa crece hasta llenar el hueco que deja la foto, sin hacer más alta la cabecera.
  const fitMap = () => {
    const map = document.querySelector<HTMLElement>('.ph .hero-map');
    const info = document.querySelector<HTMLElement>('.ph .ph-info');
    const media = document.querySelector<HTMLElement>('.ph .hero-media');
    if (!map || !info || !media) return;
    map.style.maxWidth = '';
    if (innerWidth < 961) return;
    const extra = media.offsetHeight - info.offsetHeight;
    const fig = map.firstElementChild as HTMLElement | null;
    if (!fig || extra <= 8) return;
    const pad = fig.offsetHeight - fig.offsetWidth * 0.443; // bordes y margen interior del recuadro
    const w = Math.min(map.parentElement!.clientWidth, (fig.offsetHeight + extra - 8 - pad) / 0.443);
    if (w > map.offsetWidth) map.style.maxWidth = `${Math.floor(w)}px`;
  };
  const fg = document.querySelector<HTMLImageElement>('.ph .hero-media .fg');
  if (fg && !fg.complete) fg.addEventListener('load', fitMap, { once: true });
  fitMap();
  let rt = 0; addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(fitMap, 120); });
  const modal = document.getElementById('vmodal')!;
  const frame = document.getElementById('vframe')!;
  const close = () => { modal.hidden = true; frame.innerHTML = ''; };
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((b) => b.addEventListener('click', () => {
    frame.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${b.dataset.yt}?autoplay=1&rel=0&vq=hd1080" allow="autoplay; fullscreen; encrypted-media" allowfullscreen title="Vídeo"></iframe>`;
    modal.hidden = false;
  }));
  document.getElementById('vclose')!.addEventListener('click', close);
  modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

  // Carrusel: cada pocos segundos pasa a la foto siguiente y al llegar al final vuelve al principio.
  // Se detiene mientras el ratón está encima o se toca con el dedo.
  // Una o varias filas de fotos (galería y alojamiento): cada una con su carrusel y sus flechas.
  const jump = (gal: HTMLElement, dir: number) => {
    const g0 = gal.getBoundingClientRect().left - gal.scrollLeft;
    const items = ([...gal.children] as HTMLElement[]).map((it) => { const r = it.getBoundingClientRect(); return { l: r.left - g0, r: r.right - g0 }; });
    const left = gal.scrollLeft;
    const end = gal.scrollWidth - gal.clientWidth;
    // Al final de la fila, la flecha siguiente vuelve a la primera foto (y la anterior, a la última).
    if (dir > 0 && left >= end - 2) return gal.scrollTo({ left: 0, behavior: 'smooth' });
    if (dir < 0 && left <= 2) return gal.scrollTo({ left: end, behavior: 'smooth' });
    // Avanza o retrocede de una en una foto.
    const target = dir > 0 ? items.find((it) => it.l > left + 2) : [...items].reverse().find((it) => it.l < left - 2);
    const to = target ? target.l : (dir > 0 ? end : 0);
    gal.scrollTo({ left: Math.max(0, Math.min(to, end)), behavior: 'smooth' });
  };
  document.querySelectorAll<HTMLElement>('.gallery').forEach((gal) => {
  const wrap = gal.closest<HTMLElement>('.gal-wrap') ?? gal;
  // Si todas las fotos caben a la vez, no hay carrusel ni flechas.
  const fits = () => wrap.classList.toggle('fits', gal.scrollWidth <= gal.clientWidth + 2);
  fits(); addEventListener('resize', fits); gal.querySelectorAll('img').forEach((im) => im.addEventListener('load', fits, { once: true }));
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let paused = false; let seen = false;
    wrap.addEventListener('mouseenter', () => { paused = true; }); wrap.addEventListener('mouseleave', () => { paused = false; });
    gal.addEventListener('touchstart', () => { paused = true; }, { passive: true });
    gal.addEventListener('touchend', () => setTimeout(() => { paused = false; }, 4000));
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; }).observe(gal);
    setInterval(() => { if (!paused && seen && !document.hidden && !wrap.classList.contains('fits')) jump(gal, 1); }, 3500);
  }
  // Arrastrar con el ratón para pasar las fotos.
  if (gal) {
    let down = false, moved = false, sx = 0, sl = 0;
    gal.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      down = true; moved = false; sx = e.clientX; sl = gal.scrollLeft; gal.classList.add('grab');
    });
    window.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - sx;
      if (Math.abs(dx) > 5) moved = true;
      gal.scrollLeft = sl - dx;
    });
    window.addEventListener('pointerup', () => { if (!down) return; down = false; gal.classList.remove('grab'); });
    gal.addEventListener('click', (e) => { if (moved) { e.stopPropagation(); e.preventDefault(); moved = false; } }, true);
    gal.addEventListener('dragstart', (e) => e.preventDefault());
    wrap.querySelectorAll<HTMLElement>('[data-gal]').forEach((b) => b.addEventListener('click', () => jump(gal, Number(b.dataset.gal))));
  }
  });

  // Flechas de la foto principal: pasan por todas las fotos del programa sin mover la página.
  const box = document.querySelector<HTMLElement>('.ph .hero-box');
  const hm = box?.querySelector<HTMLElement>('.hero-media');
  if (box && hm) {
    const list = [hm.dataset.src!, ...[...document.querySelectorAll<HTMLElement>('#fotos [data-src]')].map((b) => b.dataset.src!)];
    const fgI = hm.querySelector<HTMLImageElement>('.fg')!, bgI = hm.querySelector<HTMLImageElement>('.bg')!;
    let at = 0;
    // Hueco que queda a cada lado de la foto (en ordenador la foto va centrada y no ocupa todo el ancho).
    const place = () => {
      const r = fgI.getBoundingClientRect();
      const w = fgI.naturalWidth && fgI.naturalHeight ? Math.min(r.width, r.height * fgI.naturalWidth / fgI.naturalHeight) : r.width;
      box.style.setProperty('--pl', `${Math.max(0, Math.round((r.width - w) / 2))}px`);
    };
    fgI.addEventListener('load', place); if (fgI.complete) place();
    addEventListener('resize', place);
    box.querySelectorAll<HTMLElement>('[data-hero]').forEach((b) => b.addEventListener('click', () => {
      // La primera vez se fija el alto actual, para que una foto vertical no empuje el resto de la página.
      if (!box.classList.contains('locked')) { hm.style.height = `${hm.offsetHeight}px`; hm.style.width = `${hm.offsetWidth}px`; box.classList.add('locked'); }
      at = (at + Number(b.dataset.hero) + list.length) % list.length;
      fgI.removeAttribute('srcset'); bgI.removeAttribute('srcset'); fgI.src = list[at]; bgI.src = list[at];
      hm.dataset.src = list[at];
      new Image().src = list[(at + 1) % list.length];
    }));
  }
</script>

<style>
  .sp-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 18px; }
  .sp-tags span { margin-right: 6px; font: 500 11px var(--label); letter-spacing: .2em; text-transform: uppercase; color: var(--stone); }
  .sp-tags a { padding: 7px 14px; border: 1px solid var(--line); font: 500 11px var(--label); letter-spacing: .16em; text-transform: uppercase; text-decoration: none; transition: .2s; }
  .sp-tags a:hover { background: var(--red); border-color: var(--red); color: #fff; }
  .ask-box { display: grid; grid-template-columns: minmax(0, 1.4fr) auto; gap: 40px; align-items: center; border: 1px solid var(--line); border-left: 2px solid var(--red); background: var(--char); padding: clamp(24px, 3vw, 44px); }
  .ask h2 { font-size: clamp(30px, 3vw, 42px); margin: 10px 0 12px; }
  .ask p { margin: 0; color: var(--stone); max-width: 60ch; }
  .ask-btns { display: flex; flex-direction: column; gap: 12px; }
  @media (max-width: 760px) { .ask-box { grid-template-columns: 1fr; } }
  .hero-media { display: block; width: 100%; padding: 0; border: 0; cursor: zoom-in; }
  .from { margin-top: 16px; }
  .hero-btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
  .hero-media-btns { display: flex; flex-wrap: wrap; gap: 28px; margin-top: 18px; }
  .hero-map { margin-top: 18px; max-width: 560px; }
  @media (min-width: 1100px) and (max-height: 760px) { .hero-map { max-width: 440px; margin-top: 14px; } }
  @media (min-width: 961px) {
    .ph { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); align-items: center; gap: 0; padding-block: 8px; }
    .ph .hero-box { order: 2; }
    /* La foto va centrada en su hueco y no ocupa todo el ancho: las flechas se ponen sobre sus bordes (lo calcula un script). */
    .ph .hero-arrow.prev { left: calc(var(--pl, 0px) + 14px); }
    .ph .hero-arrow.next { right: calc(var(--pl, 0px) + 14px); }
    .ph .hero-box.locked .hero-media .fg { width: 100%; height: 100%; max-height: none; object-position: center; }
    .ph .hero-media { order: 2; height: auto; min-height: 0; overflow: visible; background: none; }
    .ph .hero-media .fg { position: static; display: block; width: 100%; height: auto; max-height: calc(100vh - 130px); object-fit: contain; object-position: center; }
