---
import SpeciesTiles from '../components/SpeciesTiles.astro';
import { activeSpecies } from '../data/species.js';
import Layout from '../layouts/Layout.astro';
import ProgramCard from '../components/ProgramCard.astro';
import VideoGrid from '../components/VideoGrid.astro';
import WorldMap from '../components/WorldMap.astro';
import { programs, programUrl } from '../data/programs.js';
import { categories, videos, team } from '../data/site.js';
import { u } from '../lib/url.js';

// Vídeo de portada elegido por Alvaro. Si YouTube no deja insertarlo, se cambia solo al de búfalos (fallback).
const hero = { id: 'V5wtSFkVEYo', title: 'Lances de caza · de Onís Safaris', start: 0 };
const fallback = videos.find((v) => v.id === 'Jk2uAbcHA9Q') ?? videos[0];
// Foto de portada mientras carga el vídeo (y si el móvil no lo reproduce).
const heroPoster = u('media/images/proyectos_85_dsc01123.jpg');
const bySlug = (slug) => programs.find((p) => p.slug.startsWith(slug));
// Mismo orden que la web actual.
const bestSellers = ['mozambique', 'kazakhstan', 'namibia-paquete', 'sudafrica', 'turquia'].map(bySlug);
const newPrograms = ['groenlandia', 'macedonia', 'australia'].map(bySlug);
const nHunt = new Set(programs.map((p) => p.country)).size;
const catImage = (slug) => programs.find((p) => p.category === slug)?.hero;
const catCount = (slug) => new Set(programs.filter((p) => p.category === slug).map((p) => p.country)).size;
const simProgram = programs.find((p) => p.slug === 'namibia-paquete-windhoek');
const expert = ['jabali', 'bufalo', 'leopardo', 'oso', 'ibex', 'rebeco', 'antilopes', 'corzo', 'ciervo', 'alce-caribu-muskox'].map((k) => activeSpecies.find((s) => s.slug === k)).filter(Boolean);
---
<Layout transparentHeader image={heroPoster}>
  <section class="hero dark" id="hero">
    <div class="hero-media">
      <img class="poster" src={heroPoster} alt="" aria-hidden="true" fetchpriority="high" />
      <iframe
        id="hero-video"
        data-start={hero.start ?? 0}
        data-fallback={`https://www.youtube-nocookie.com/embed/${fallback.id}?autoplay=1&mute=1&loop=1&playlist=${fallback.id}&controls=0&modestbranding=1&playsinline=1&rel=0&iv_load_policy=3&disablekb=1&enablejsapi=1&vq=hd1080${fallback.start ? `&start=${fallback.start}` : ''}`}
        data-fallback-start={fallback.start ?? 0}
        data-src={`https://www.youtube-nocookie.com/embed/${hero.id}?autoplay=1&mute=1&loop=1&playlist=${hero.id}&controls=0&modestbranding=1&playsinline=1&rel=0&iv_load_policy=3&disablekb=1&enablejsapi=1&vq=hd1080${hero.start ? `&start=${hero.start}` : ''}`}
        title="Lances de caza de de Onís Safaris"
        allow="autoplay; encrypted-media"
        tabindex="-1"
        aria-hidden="true"></iframe>
    </div>
    <div class="hero-shade"></div>
    <div class="wrap hero-content">
      <h1>Tu caza de los BIG&nbsp;FIVE diseñada a la medida de tus necesidades</h1>
      <p>Contáctanos y te propondremos el safari que mejor se adapta a tus requerimientos</p>
      <nav class="hero-cats" aria-label="Destinos">
        {['caza-en-africa', 'caza-en-america', 'caza-en-asia', 'caza-en-europa', 'caza-en-oceania'].map((k) => categories.find((c) => c.slug === k)).map((c) => <a href={u(c.slug)}>{c.name}</a>)}
      </nav>
      <nav class="hero-cats" aria-label="Caza con arco"><a href={u('caza-con-arco')}>Caza con arco</a><a href={u('videos')}>Ver vídeos de caza</a></nav>
    </div>
    <button type="button" class="sound" id="sound" aria-pressed="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z" /><path id="sound-x" d="M16 9l5 6M21 9l-5 6" /></svg>
      <span>Activar sonido</span>
    </button>
  </section>

  <section id="destinos">
    <div class="wrap">
      <div class="sec-head">
        <div><div class="eyebrow">Caza por los 5 continentes</div><h2>Elige continente</h2></div>
        <p class="lead">Dentro de cada continente encontrarás los países y en cada país sus programas, con precios, temporadas y simulador de presupuesto.</p>
      </div>
      <div class="mosaic">
        {categories.map((c, i) => (
          <a class:list={['photo-card', `m${i}`]} href={u(c.slug)}>
            <img src={catImage(c.slug)} alt={c.title} loading="lazy" />
            <div class="info">
              <div class="eyebrow">{catCount(c.slug)} {catCount(c.slug) === 1 ? 'país' : 'países'}</div>
              <h3>{c.title}</h3>
              <div class="meta">{c.tagline}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="expert">
    <div class="wrap">
      <div class="sec-head">
        <div><div class="eyebrow">Caza por especie</div><h2>Somos expertos en…</h2></div>
        <p class="lead">Jabalíes, búfalos, leopardos, osos, íbex, rebecos… Elija la especie y le mostramos dónde la cazamos y con qué programas. <a href={u('especies')}>Ver todas las especies →</a></p>
      </div>
      <SpeciesTiles list={expert} />
    </div>
  </section>

  <section class="map-sec dark">
    <div class="wrap map-head">
      <div class="map-txt">
        <div class="eyebrow">Dónde cazamos</div>
        <h2>{nHunt} países en cinco continentes</h2>
        <p>Solo enviamos a un cliente donde alguien de nuestro equipo ha cazado antes.</p>
      </div>
        <ul class="map-conts">
          {categories.filter((c) => c.slug !== 'caza-con-arco').map((c) => <li><a href={u(c.slug)}><span>{c.name}</span><b>{catCount(c.slug)}</b></a></li>)}
        </ul>
    </div>
    <div class="map-full"><WorldMap /></div>
  </section>

  <section class="featured">
    <div class="wrap">
      <div class="sec-head">
        <div><div class="eyebrow">Temporada 2026</div><h2>Programas más vendidos</h2></div>
        <p class="lead">Consulta en cada programa nuestra tarifa de precios y condiciones, y calcula tu presupuesto.</p>
      </div>
      <div class="bestsellers">
        {bestSellers.map((p) => <ProgramCard p={p} />)}
      </div>
    </div>
  </section>

  <section class="about">
    <div class="wrap">
      <div class="about-text">
        <div class="eyebrow">Quiénes somos</div>
        <h2>de Onís Safaris</h2>
        <p class="lead">Organizamos cacerías por los cinco continentes con los mejores outfitters. Todo nuestro equipo es cazador, con más de 30 años de experiencia.</p>
        <blockquote>Nuestra máxima es no llevar nunca a un cazador a un destino donde alguno de nosotros no haya cazado antes.</blockquote>
        <a class="btn outline" href={u('sobre-nosotros')}>Sobre nosotros</a>
      </div>
    </div>
    <div class="faces dark">
      {team.map((t) => (
        <figure>
          <img src={t.photo} alt={t.name} loading="lazy" />
          <figcaption><b>{t.name}</b><span>{t.role}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="new">
    <div class="wrap">
      <div class="sec-head">
        <div><div class="eyebrow">Novedades</div><h2>Nuevos programas</h2></div>
        <p class="lead">Te presentamos los safaris más destacados y los más novedosos.</p>
      </div>
      <div class="grid-3">{newPrograms.map((p) => <ProgramCard p={p} />)}</div>
    </div>
  </section>

  <section class="sim-band dark">
    <div class="wrap">
      <div>
        <div class="eyebrow">Nuevo</div>
        <h2>Calcula tu presupuesto en un minuto</h2>
        <p class="lead">En cada programa eliges el paquete, cuántos cazadores y acompañantes vais y los animales que quieres. Te mostramos el coste estimado al momento y nos lo puedes enviar por WhatsApp.</p>
        <a class="btn" href={`${u(programUrl(simProgram))}#simulador`}>Probar con Namibia · paquete Windhoek</a>
      </div>
      <div class="sim-mock" aria-hidden="true">
        <div class="row"><span>Paquete 10 días · 1×1</span><b>2 × US$ 17.500</b></div>
        <div class="row"><span>Acompañante · 10 días</span><b>US$ 4.200</b></div>
        <div class="row"><span>Nyala</span><b>US$ 4.500</b></div>
        <div class="row"><span>Certificados y transporte</span><b>US$ 1.950</b></div>
        <div class="row total"><span>Total estimado</span><b>US$ 45.650</b></div>
      </div>
    </div>
  </section>

  <section class="videos">
    <div class="wrap">
      <div class="sec-head">
        <div><div class="eyebrow">En el campo</div><h2>Vídeos destacados</h2></div>
        <a class="btn outline" href={u('videos')}>Todos los vídeos</a>
      </div>
      <VideoGrid videos={videos.slice(1, 6)} />
    </div>
  </section>

  <section class="contact-home" id="contacto">
    <div class="wrap">
      <div>
        <div class="eyebrow">Contacto</div>
        <h2>Contacta con nosotros</h2>
        <p class="lead">Estaremos encantados de atenderte.</p>
        <div class="leads">
          {team.filter((t) => t.phone).map((t) => (
            <div><img src={t.photo} alt={t.name} loading="lazy" /><span><b>{t.name}</b>{t.phone}<br />{t.email}</span></div>
          ))}
        </div>
      </div>
      <form id="home-form">
        <label>Nombre<input id="h-name" name="nombre" required autocomplete="name" /></label>
        <label>Teléfono<input id="h-phone" name="telefono" autocomplete="tel" /></label>
        <label class="full">Email<input id="h-email" name="email" type="email" required autocomplete="email" /></label>
        <label class="full">¿Qué te gustaría cazar?<textarea id="h-msg" name="mensaje" rows="4"></textarea></label>
        <label class="full chk"><input type="checkbox" required /> He leído y acepto la política de privacidad</label>
        <button class="btn full" type="submit">Enviar</button>
      </form>
    </div>
  </section>
</Layout>

<style>
  .expert .lead a { color: var(--red-hi); white-space: nowrap; }
  .hero { position: relative; height: 100vh; height: 100svh; min-height: 560px; padding: 0; overflow: hidden; display: flex; align-items: center; }
  .hero-media { position: absolute; inset: 0; background: var(--black) center / cover no-repeat; }
  .hero-media .poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-media iframe {
    position: absolute; top: 50%; left: 50%; border: 0; pointer-events: none;
    width: 122vw; height: 68.63vw; min-height: 122%; min-width: 216.9vh;
    transform: translate(-50%, -50%);
    opacity: 0; transition: opacity 1.2s;
  }
  .hero-media iframe.on { opacity: 1; }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.55) 0%, rgba(0,0,0,.3) 35%, rgba(0,0,0,.4) 60%, rgba(13,14,13,.95) 100%); }
  .hero-content { position: relative; z-index: 1; width: 100%; padding-bottom: 0; text-align: center; display: flex; flex-direction: column; align-items: center; padding-top: 80px; }
  .hero h1 { font: 400 clamp(30px, 3.7vw, 68px)/1.15 'Montserrat', sans-serif; margin: 0 auto 26px; max-width: none; text-shadow: 0 2px 20px rgba(0,0,0,.4); }
  .hero-cats { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .hero-cats + .hero-cats { margin-top: 10px; }
  .hero-cats a { font: 400 clamp(15px, 1.25vw, 20px) Arial, Helvetica, sans-serif; text-transform: uppercase; text-decoration: none; padding: 15px clamp(24px, 3.2vw, 60px); border: 1px solid #fff; border-radius: 3px; background: rgba(0,0,0,.25); color: #fff; transition: .2s; }
  .hero-cats a:hover { background: #fff; color: #111; }
  /* En el móvil, como en la web actual: filas centradas, cada botón a su medida. */
  @media (max-width: 600px) { .hero h1 { font-size: 24px; margin-bottom: 14px; } .hero-content > p { font-size: 17px; } .hero-cats { gap: 6px; } .hero-cats + .hero-cats { margin-top: 6px; } .hero-cats a { font-size: 15px; padding: 9px 20px; } }
  .hero-arco { font: 500 12px var(--label); letter-spacing: .18em; text-transform: uppercase; text-decoration: none; padding: 12px 34px; background: var(--red); border: 1px solid var(--red); transition: .2s; }
  .hero-arco:hover { background: var(--red-hi); border-color: var(--red-hi); }
  .hero-videos { display: inline-flex; align-items: center; gap: 10px; font: 500 11px var(--label); letter-spacing: .14em; text-transform: uppercase; text-decoration: none; }
  .hero-videos svg { width: 30px; height: 30px; padding: 8px; border-radius: 50%; border: 1px solid rgba(255,255,255,.5); fill: #fff; }
  .hero p { font: 400 clamp(17px, 1.6vw, 24px)/1.4 'Roboto Slab', serif; color: #fff; max-width: none; margin: 0 auto 40px; text-shadow: 0 2px 14px rgba(0,0,0,.4); }
  .hero-btns { display: flex; flex-wrap: wrap; gap: 14px; }
  .sound { position: absolute; z-index: 2; right: var(--gutter); bottom: clamp(64px, 11vh, 120px); display: flex; align-items: center; gap: 10px; background: rgba(0,0,0,.35); border: 1px solid rgba(255,255,255,.4); color: #fff; padding: 10px 16px; cursor: pointer; font: 500 10px var(--label); letter-spacing: .14em; text-transform: uppercase; backdrop-filter: blur(6px); }
  .sound svg { width: 20px; height: 20px; fill: #fff; stroke: #fff; stroke-width: 2; }
  .sound[aria-pressed='true'] #sound-x { display: none; }
  @media (max-width: 700px) { .sound { bottom: auto; top: 96px; } .sound span { display: none; } }


  .mosaic { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: clamp(170px, 16vw, 230px); gap: 10px; }
  .mosaic .photo-card .info { padding: 18px 20px; }
  .mosaic .photo-card h3 { font-size: clamp(24px, 2vw, 30px); }
  .mosaic .photo-card .meta { font-size: 13px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 860px) { .mosaic { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .mosaic { grid-template-columns: 1fr; } }

  .featured { background: var(--char); }
  .bestsellers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: clamp(260px, 26vw, 380px); gap: 16px; }
  .bestsellers > :first-child { grid-column: span 2; }
  .bestsellers > :first-child h3 { font-size: clamp(32px, 3.2vw, 46px); }
  @media (max-width: 860px) { .bestsellers { grid-template-columns: 1fr 1fr; } .bestsellers > :first-child { grid-column: span 2; } }
  @media (max-width: 520px) { .bestsellers { grid-template-columns: 1fr; } .bestsellers > :first-child { grid-column: auto; } }

  .about-text { max-width: 900px; margin: 0 auto 36px; text-align: center; }
  .about-text .lead { margin-inline: auto; }
  .about h2 { font-size: clamp(38px, 4.6vw, 66px); margin: 12px 0 20px; }
  .about blockquote { margin: 24px auto 28px; padding: 18px 0 0; border-top: 1px solid var(--red); max-width: 34ch; font: italic 500 clamp(24px, 2.4vw, 34px)/1.25 var(--display); }
  .new { background: var(--char); }

  .contact-home .wrap { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 56px; }
  .contact-home h2 { font-size: clamp(36px, 4.2vw, 60px); margin: 10px 0 16px; }
  .leads { display: grid; gap: 16px; margin-top: 28px; }
  .leads div { display: flex; gap: 16px; align-items: center; color: var(--stone); font-size: 15px; }
  .leads img { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; background: var(--char); }
  .leads b { display: block; color: var(--bone); font: 600 24px/1.2 var(--display); }
  #home-form { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; background: var(--char); padding: clamp(20px, 3vw, 40px); align-self: start; }
  #home-form label { display: flex; flex-direction: column; gap: 6px; font: 500 10px var(--label); letter-spacing: .12em; text-transform: uppercase; color: var(--stone); }
  #home-form .full { grid-column: 1 / -1; }
  #home-form input, #home-form textarea { font: 16px var(--body); color: var(--bone); background: var(--black); border: 1px solid var(--line); padding: 13px; min-width: 0; }
  #home-form .chk { flex-direction: row; align-items: center; gap: 10px; letter-spacing: 0; text-transform: none; font: 15px var(--body); }
  #home-form .chk input { width: 18px; height: 18px; accent-color: var(--red); }
  @media (max-width: 860px) { .contact-home .wrap, #home-form { grid-template-columns: 1fr; } }


  .sim-band .wrap { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 56px; align-items: center; }
  .sim-band h2 { font-size: clamp(34px, 3.8vw, 54px); margin: 12px 0 18px; }
  .sim-band .lead { margin-bottom: 30px; }
  .sim-mock { background: var(--char); border-top: 1px solid var(--red); padding: 28px; font-variant-numeric: tabular-nums; }
  .sim-mock .row { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); color: var(--stone); }
  .sim-mock .row b { color: var(--bone); font-weight: 600; }
  .sim-mock .total { border: 0; padding-top: 20px; color: var(--bone); font: 500 12px var(--label); text-transform: uppercase; letter-spacing: .22em; align-items: baseline; }
  .sim-mock .total b { font: 600 34px var(--display); letter-spacing: 0; color: #fff; }
  @media (max-width: 860px) { .sim-band .wrap { grid-template-columns: 1fr; } }

  .videos { background: var(--char); }

  .faces { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(220px, 1fr); gap: 2px; overflow-x: auto; scrollbar-width: none; }
  .faces figure { position: relative; margin: 0; aspect-ratio: 3 / 4; overflow: hidden; background: var(--char); }
  .faces img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.05); transition: filter .4s, transform .6s; }
  .faces figure:hover img { filter: none; transform: scale(1.04); }
  .faces figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 18px; background: linear-gradient(transparent, rgba(0,0,0,.85)); }
  .faces b { display: block; font: 600 24px/1.1 var(--display); }
  .faces span { font-size: 14px; color: rgba(242,239,232,.8); }

  .map-sec { background: #0d0e0d; }
  .map-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px 48px; flex-wrap: wrap; }
  .map-full { max-width: 1680px; margin: 10px auto 0; padding-inline: 12px; }
  .map-txt h2 { font-size: clamp(32px, 3vw, 44px); margin: 12px 0 14px; line-height: 1.08; }
  .map-txt p { color: var(--stone); margin: 0; }
  .map-conts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 26px; }
  .map-conts a { display: flex; gap: 8px; align-items: baseline; padding: 6px 0; border-bottom: 1px solid transparent; text-decoration: none; font: 500 12px var(--label); letter-spacing: .16em; text-transform: uppercase; transition: color .2s, padding .2s; }
  .map-conts b { font: 500 22px var(--display); letter-spacing: 0; color: var(--red); }
  .map-conts a:hover { color: var(--red); border-color: var(--red); }
</style>

<script>
  const iframe = document.getElementById('hero-video') as HTMLIFrameElement;
  // Dejamos ver la miniatura mientras YouTube arranca y luego fundimos el vídeo.
  // Solo se muestra cuando ya está reproduciendo, para que no se vea la interfaz de YouTube.
  let START = Number(iframe.dataset.start || 0);
  const listen = () => iframe.contentWindow?.postMessage(JSON.stringify({ event: 'listening', id: 'hero' }), '*');
  iframe.addEventListener('load', () => { listen(); setTimeout(listen, 800); });
  // El vídeo (más de 1 MB de YouTube) se carga cuando la página ya se ve, para no frenarla.
  const startVideo = () => setTimeout(() => { if (!iframe.src || iframe.src === 'about:blank') iframe.src = iframe.dataset.src!; }, 300);
  if (document.readyState === 'complete') startVideo(); else window.addEventListener('load', startVideo, { once: true });
  window.addEventListener('message', (e) => {
    if (!/youtube/.test(e.origin)) return;
    try {
      const d = typeof e.data === 'string' ? JSON.parse(e.data) : e.data;
      // Vídeo que no se puede insertar (errores 101/150) o no disponible: pasamos al de reserva.
      if (d.event === 'onError' && iframe.dataset.fallback && iframe.src !== iframe.dataset.fallback) {
        START = Number(iframe.dataset.fallbackStart || 0);
        iframe.src = iframe.dataset.fallback; iframe.dataset.fallback = '';
        return;
      }
      const st = d.event === 'onStateChange' ? d.info : d.info?.playerState;
      if (st === 1) setTimeout(() => iframe.classList.add('on'), 400);
      // Al repetirse, saltamos otra vez la entrada con letras.
      const ct = d.info?.currentTime;
      if (typeof ct === 'number' && ct < START - 1) iframe.contentWindow?.postMessage(JSON.stringify({ event: 'command', func: 'seekTo', args: [START, true] }), '*');
    } catch {}
  });
  const btn = document.getElementById('sound')!;
  const cmd = (func: string) => iframe.contentWindow?.postMessage(JSON.stringify({ event: 'command', func, args: [] }), '*');
  document.getElementById('home-form')!.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(e.target as HTMLFormElement);
    const body = [...f.entries()].map(([k, v]) => `${k}: ${v}`).join('\n');
    location.href = `mailto:info@deonissafaris.com?subject=${encodeURIComponent('Solicitud de safari')}&body=${encodeURIComponent(body)}`;
  });
  const setSound = (on: boolean) => {
    cmd(on ? 'unMute' : 'mute');
    if (on) cmd('playVideo');
    btn.setAttribute('aria-pressed', String(on));
    btn.querySelector('span')!.textContent = on ? 'Silenciar' : 'Activar sonido';
  };
  let userChose = false;
  btn.addEventListener('click', (e) => {
    e.stopPropagation();
    userChose = true;
    setSound(btn.getAttribute('aria-pressed') !== 'true');
  });
  // Los navegadores no dejan arrancar un vídeo con sonido sin una acción del visitante:
  // lo activamos en cuanto toca, pulsa o teclea algo en la página (mientras el vídeo está a la vista).
  const firstTouch = () => {
    ['pointerdown', 'keydown', 'touchstart'].forEach((ev) => window.removeEventListener(ev, firstTouch));
    if (!userChose && window.scrollY < window.innerHeight) setSound(true);
  };
  ['pointerdown', 'keydown', 'touchstart'].forEach((ev) => window.addEventListener(ev, firstTouch, { passive: true }));
</script>
