---
import Layout from '../layouts/Layout.astro';
import { articles } from '../data/media.js';
---
<Layout title="Artículos y revistas" description="Artículos sobre nuestras cacerías publicados en revistas especializadas.">
  <section class="head">
    <div class="wrap">
      <div class="eyebrow">En la prensa</div>
      <h1>Artículos y revistas</h1>
      <p class="lead">Reportajes sobre nuestras cacerías publicados en revistas especializadas como Trofeo. Pulsa un artículo para abrirlo en PDF.</p>
    </div>
  </section>
  <section class="list">
    <div class="wrap">
      {articles.map((g) => (
        <div class="country">
          <h2>{g.country}</h2>
          <ul>
            {g.items.map((a) => (
              <li>
                <a href={a.url} target="_blank" rel="noopener">
                  <span class="t">{a.title}</span>
                  {a.note && <span class="n">{a.note}</span>}
                  <span class="pdf">PDF ↗</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .head { padding-block: var(--page-top) 16px; }
  .head h1 { font-size: clamp(44px, 5vw, 72px); margin: 10px 0 12px; }
  .list { padding-top: 24px; }
  .country { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 32px; padding: 26px 0; border-top: 1px solid var(--line); }
  .country h2 { font-size: 30px; }
  ul { list-style: none; margin: 0; padding: 0; }
  li a { display: flex; align-items: baseline; gap: 18px; padding: 12px 0; text-decoration: none; border-bottom: 1px solid var(--line); }
  li:last-child a { border-bottom: 0; }
  .t { font: 500 22px/1.3 var(--display); color: var(--bone); transition: color .2s; }
  .n { font-size: 13px; color: var(--stone); }
  .pdf { margin-left: auto; font: 500 11px var(--label); letter-spacing: .2em; color: var(--red-hi); white-space: nowrap; }
  li a:hover .t { color: var(--red-hi); }
  @media (max-width: 700px) { .country { grid-template-columns: 1fr; gap: 8px; } .t { font-size: 20px; } }
</style>
